{
  "name": "hhikr-moe",
  "type": "module",
  "version": "2.0.0",
  "private": true,
  "description": "hhikr 的个人网站 — https://hhikr.moe",
  "scripts": {
    "dev": "astro dev",
    "prebuild": "node scripts/package-hot100-java.mjs && node scripts/build-static-images.mjs",
    "predev": "node scripts/build-static-images.mjs",
    "import:posts": "node scripts/import-posts.mjs",
    "test:server": "node --test \"tests/server/*.test.mjs\"",
    "build": "astro check && astro build && pagefind --site dist/client",
    "preview": "astro preview",
    "new": "node scripts/new-post.mjs",
    "astro": "astro",
    "test:hot100": "node tests/hot100/verify.mjs && node tests/hot100/verify-algorithms.mjs && node tests/hot100/verify-structures.mjs && node tests/hot100/verify-demo-input.mjs && node tests/hot100/verify-judge.mjs && node tests/hot100/verify-theme-transition.mjs && node tests/hot100/verify-reveal-motion.mjs",
    "java:serve": "node tools/hot100-java/server.mjs --site https://hhikr.moe",
    "java:package": "node scripts/package-hot100-java.mjs",
    "test:hot100:java": "node tests/hot100/verify-java.mjs && node tests/hot100/verify-java-boundaries.mjs"
  },
  "dependencies": {
    "@astrojs/check": "^0.9.10",
    "@astrojs/markdown-remark": "^7.3.2",
    "@astrojs/node": "^11.1.7",
    "@astrojs/rss": "^4.0.19",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource/instrument-serif": "^5.3.0",
    "astro": "^7.3.7",
    "hastscript": "^9.0.1",
    "katex": "^0.19.0",
    "lxgw-wenkai-screen-web": "^1.522.0",
    "pagefind": "^1.5.2",
    "rehype-katex": "^7.0.1",
    "remark-directive": "^4.0.0",
    "remark-math": "^6.0.0",
    "sharp": "^0.35.5",
    "typescript": "^6.0.3",
    "unist-util-visit": "^5.1.0"
  },
  "devDependencies": {
    "@types/node": "^24.19.2"
  }
}
