---
// Comments under a post. The markup is the same for every visitor; who is
// signed in is worked out in the browser (src/scripts/comments.ts). Guests see
// the same composer and are asked to sign in only when they press 发送.
import { googleConfig } from '@/server/config.ts';

interface Props {
  slug: string;
}
const { slug } = Astro.props;
const returnTo = encodeURIComponent(`/posts/${slug}/#comments`);
const tools: [string, string, string][] = [
  ['b', 'B', '粗体'],
  ['i', 'I', '斜体'],
  ['u', 'U', '下划线'],
  ['s', 'S', '删除线'],
  ['mask', '遮罩', '遮罩文字，点击后显示'],
  ['url', '链接', '链接'],
  ['img', '图片', '图片：填写图床上的图片地址（https）'],
  ['quote', '引用', '引用'],
  ['code', '代码', '代码'],
];
---

<section class="comments" id="comments" data-comments data-slug={slug} aria-label="评论">
  <h2 class="group-head">
    <span>评论</span>
    <span class="mono" data-count></span>
  </h2>

  <ol class="c-list" data-list></ol>

  <div class="c-profile" data-profile hidden></div>

  <form class="c-composer form" data-composer novalidate>
    <div class="c-replying" data-replying hidden>
      <span></span>
      <button type="button" class="c-link">取消</button>
    </div>
    <div class="c-tools" data-tools role="toolbar" aria-label="格式">
      {
        tools.map(([tag, label, title]) => (
          <button type="button" data-tag={tag} title={title} class={`t-${tag}`}>
            {label}
          </button>
        ))
      }
    </div>
    <textarea name="source" rows="5" maxlength="5000" placeholder="写下你的评论。支持 BBCode，例如 [b]粗体[/b]、[img]图片地址[/img]。" aria-label="评论内容"></textarea>
    <!-- Hidden from people; bots that fill it in are turned away. -->
    <input class="c-trap" name="website" tabindex="-1" autocomplete="off" aria-hidden="true" />
    <div class="c-preview" data-preview hidden></div>
    <div class="c-bar">
      <p class="c-status" data-status role="status"></p>
      <button type="button" class="btn" data-preview-toggle>预览</button>
      <button type="submit" class="btn go c-send">发送</button>
    </div>
  </form>

  <dialog class="c-auth" data-auth aria-label="登录后发表评论">
    <button type="button" class="c-close" data-auth-close aria-label="关闭">×</button>
    <h3>登录后发表评论</h3>
    <p class="c-hint">写好的内容会保留，登录后自动发出。</p>
    {
      googleConfig() && (
        <a class="btn go c-google" data-google data-astro-prefetch="false" href={`/api/auth/google/start?return=${returnTo}`}>
          使用 Google 登录
        </a>
      )
    }
    <form class="form" novalidate>
      <label class="field">
        <span class="label">名字</span>
        <input name="name" autocomplete="username" maxlength="40" />
        <small>注册时填昵称；登录时填完整的名字，例如 narrator#1145。</small>
      </label>
      <label class="field">
        <span class="label">密码</span>
        <input name="password" type="password" autocomplete="current-password" maxlength="200" />
        <small>至少 10 个字符。没有绑定邮箱，忘记后无法找回。</small>
      </label>
      <input class="c-trap" name="website" tabindex="-1" autocomplete="off" aria-hidden="true" />
      <p class="c-status" data-auth-message role="status"></p>
      <div class="c-bar">
        <button type="submit" class="btn go c-send">登录</button>
        <button type="button" class="btn" data-register>注册新账号</button>
        <a class="c-fine" href="/privacy/" target="_blank">隐私说明</a>
      </div>
    </form>
    <div data-welcome hidden>
      <p>注册好了。你的完整名字是</p>
      <p class="c-handle" data-handle></p>
      <p>昵称可以和别人重名，后面的四位数字用来区分。<strong>以后登录需要输入这个完整的名字</strong>，请记下来。</p>
      <button type="button" class="btn go c-send">知道了，发送评论</button>
    </div>
  </dialog>
</section>

<script>
  import '@/scripts/comments';
</script>

<style is:global>
  .comments {
    margin-top: 4rem;
  }

  .c-list,
  .c-replies {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .c-item {
    display: grid;
    grid-template-columns: 2.5rem minmax(0, 1fr);
    gap: 0.9rem;
    padding: 1.25rem 0;
    border-bottom: 1px solid var(--rule);
  }

  .c-replies {
    margin-top: 1rem;
    padding-left: 1rem;
    border-left: 1px solid var(--ink);
  }

  .c-replies .c-item {
    padding: 0.9rem 0 0;
    border-bottom: 0;
  }

  /* square, like everything else on the site */
  .c-avatar {
    width: 2.5rem;
    height: 2.5rem;
    object-fit: cover;
    background: var(--chip);
  }

  .c-initial {
    display: grid;
    place-items: center;
    background: var(--tag-bg);
    color: var(--tag-fg);
    font-family: var(--font-ui);
    font-size: 1.1rem;
    font-weight: 700;
    line-height: 1;
    user-select: none;
  }

  .c-head {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.25rem 0.75rem;
    font-family: var(--font-ui);
  }

  .c-name {
    font-weight: 700;
  }

  .c-tag {
    margin-left: 0.1em;
    font-family: var(--font-mono);
    font-size: 0.8em;
    font-weight: 400;
    color: var(--ink-2);
  }

  .c-badge {
    margin-left: 0.5em;
    padding: 0 0.45em;
    background: var(--signal);
    color: var(--on-signal);
    font-family: var(--font-mono);
    font-size: 0.66rem;
    font-weight: 700;
    vertical-align: 0.15em;
  }

  .c-head time {
    font-family: var(--font-mono);
    font-size: var(--t-mono);
    color: var(--ink-2);
  }

  /* waiting for review: marked the way this site marks things that need a look */
  .c-pending {
    padding: 0 0.4em;
    background: var(--signal);
    color: var(--on-signal);
    font-size: 0.75rem;
  }

  .c-body {
    margin-top: 0.35rem;
    line-height: 1.75;
    overflow-wrap: anywhere;
  }

  .c-body a,
  .c-preview a {
    color: var(--ink);
    text-decoration: underline;
    text-decoration-color: var(--signal);
    text-decoration-thickness: 0.4em;
    text-underline-offset: -0.18em;
    text-decoration-skip-ink: none;
  }

  :root[data-theme='dark'] :is(.c-body, .c-preview) a {
    text-decoration-thickness: 1.5px;
    text-underline-offset: 0.25em;
  }

  .c-body img,
  .c-preview img {
    display: block;
    max-width: min(100%, 28rem);
    max-height: 24rem;
    margin: 0.5rem 0;
    cursor: zoom-in;
  }

  .c-body blockquote,
  .c-preview blockquote {
    margin: 0.5rem 0;
    padding: 0.1rem 0 0.1rem 0.9rem;
    border-left: 3px solid var(--ink);
    color: var(--ink-2);
  }

  .c-body pre,
  .c-preview pre {
    margin: 0.5rem 0;
    padding: 0.75rem 0.9rem;
    border: 1px solid var(--rule);
    background: var(--paper);
    font-family: var(--font-mono);
    font-size: 0.85rem;
    line-height: 1.6;
    overflow-x: auto;
  }

  .c-gone,
  .c-broken {
    color: var(--ink-2);
    font-size: 0.9rem;
  }

  .c-gone {
    margin: 0;
  }

  .c-actions {
    display: flex;
    gap: 1rem;
    margin-top: 0.4rem;
  }

  .c-link {
    padding: 0;
    border: 0;
    border-bottom: 1px solid transparent;
    background: none;
    color: var(--ink-2);
    font-family: var(--font-mono);
    font-size: 0.75rem;
    cursor: pointer;
  }

  .c-link:hover {
    color: var(--ink);
    border-color: var(--ink);
  }

  .c-profile {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem;
    margin-top: 2rem;
    font-family: var(--font-ui);
  }

  .c-profile[hidden],
  .c-composer[hidden],
  .c-replying[hidden],
  .c-preview[hidden],
  .c-auth form[hidden],
  .c-google[hidden] {
    display: none;
  }

  .c-me {
    color: var(--ink-2);
    font-size: 0.92rem;
  }

  .c-menu {
    display: flex;
    gap: 1rem;
    margin-left: auto;
  }

  .c-composer {
    display: grid;
    gap: 0.6rem;
    margin-top: 1.25rem;
  }

  .c-replying {
    display: flex;
    align-items: center;
    gap: 1rem;
    padding: 0.4rem 0.75rem;
    border-left: 4px solid var(--trace);
    background: var(--paper);
    font-family: var(--font-ui);
    font-size: 0.88rem;
  }

  .c-tools {
    display: flex;
    flex-wrap: wrap;
    gap: 2px;
  }

  .c-tools button {
    min-width: 2rem;
    padding: 0.2rem 0.6rem;
    border: 0;
    background: var(--chip);
    color: var(--ink);
    font-family: var(--font-ui);
    font-size: 0.8rem;
    cursor: pointer;
    transition: background-color 0.1s;
  }

  .c-tools button:hover {
    background: var(--signal);
    color: var(--on-signal);
  }

  .c-tools .t-b {
    font-weight: 800;
  }
  .c-tools .t-i {
    font-style: italic;
  }
  .c-tools .t-u {
    text-decoration: underline;
  }
  .c-tools .t-s {
    text-decoration: line-through;
  }

  .c-composer textarea {
    min-height: 7rem;
    font-family: var(--font-text);
    font-size: var(--t-body);
    line-height: 1.75;
  }

  .c-trap {
    position: absolute;
    left: -100vw;
    width: 1px;
    height: 1px;
    opacity: 0;
  }

  .c-preview {
    padding: 0.75rem 0.9rem;
    border: 1px dashed var(--ink-2);
    line-height: 1.75;
    overflow-wrap: anywhere;
  }

  .c-bar {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem;
  }

  /* what went wrong, flagged in yellow; empty, it takes no room */
  .c-status {
    flex: 1 1 12rem;
    min-height: 1.4em;
    margin: 0;
    color: var(--ink);
    font-family: var(--font-ui);
    font-size: 0.86rem;
  }

  .c-status:not(:empty)::before {
    content: '注意';
    margin-right: 0.5rem;
    padding: 0 0.4em;
    background: var(--signal);
    color: var(--on-signal);
    font-size: 0.75rem;
    font-weight: 700;
  }

  /* the sign-in and account boxes: a plate with an ink tab on top */
  .c-auth {
    width: min(28rem, calc(100vw - 2rem));
    max-height: calc(100dvh - 2rem);
    padding: 1.75rem;
    border: 1px solid var(--ink);
    border-top-width: 5px;
    background: var(--panel);
    color: var(--ink);
    font-family: var(--font-ui);
  }

  .c-auth::backdrop {
    background: color-mix(in srgb, var(--paper) 55%, rgb(10 10 10 / 0.5));
  }

  @media (prefers-reduced-motion: no-preference) {
    .c-auth[open] {
      animation: c-open 0.28s var(--mech);
    }
    @keyframes c-open {
      from {
        clip-path: inset(0 0 100% 0);
      }
      to {
        clip-path: inset(0);
      }
    }
  }

  .c-auth h3 {
    margin: 0;
    font-size: 1.4rem;
    font-weight: 800;
  }

  .c-account section {
    display: grid;
    gap: 0.6rem;
    justify-items: start;
    padding: 1rem 0;
    border-top: 1px solid var(--rule);
  }

  .c-account h4,
  .c-account p {
    margin: 0;
  }

  .c-account h4 {
    color: var(--ink);
  }

  .c-account form {
    display: grid;
    gap: 0.75rem;
    justify-items: start;
    width: 100%;
    margin: 0;
    padding: 0;
    border: 0;
  }

  .c-account label {
    width: 100%;
  }

  .c-hint {
    margin: 0.35rem 0 1.25rem;
    color: var(--ink-2);
    font-size: 0.88rem;
  }

  .c-close {
    position: absolute;
    top: 0.6rem;
    right: 0.8rem;
    border: 0;
    background: none;
    color: var(--ink-2);
    font-size: 1.4rem;
    line-height: 1;
    cursor: pointer;
  }

  .c-close:hover {
    color: var(--ink);
  }

  .c-google {
    width: 100%;
    justify-content: center;
  }

  .c-auth > form {
    display: grid;
    gap: 0.9rem;
    margin-top: 1.25rem;
    padding-top: 1.25rem;
    border-top: 1px solid var(--rule);
  }

  .c-fine {
    color: var(--ink-2);
    font-size: 0.8rem;
  }

  .c-bar .c-fine {
    margin-left: auto;
    border-bottom: 1px solid var(--rule);
  }

  .c-handle {
    display: inline-block;
    padding: 0.1em 0.45em;
    background: var(--signal);
    color: var(--on-signal);
    font-family: var(--font-mono);
    font-size: 1.5rem;
  }
</style>
