---
import { categoryOf, fmtDate, postUrl, seriesName, type Post } from '@/lib/posts';
import Icon from './Icon.astro';

interface Props {
  post: Post;
  index?: number;
  showSummary?: boolean;
  [attr: `data-${string}`]: string | undefined;
}

const { post, index, showSummary = true, ...attrs } = Astro.props;
const cat = categoryOf(post);
const { title, summary, date, series, hidden } = post.data;
---

<li class="row rise" style={index !== undefined ? `--i:${index}` : undefined} {...attrs}>
  <a href={postUrl(post)} class="row-link">
    <span class="meta">
      {index !== undefined && <span class="num">{String(index + 1).padStart(2, '0')}</span>}
      <time datetime={date.toISOString()}>{fmtDate(date)}</time>
    </span>
    <span class="main">
      <span class="title cjk">
        {title}
        {hidden && <span class="badge-draft">隐藏</span>}
      </span>
      {showSummary && summary && <span class="summary">{summary}</span>}
    </span>
    <span class="side">
      {series && <span class="label series">{seriesName(series)}</span>}
      {cat && <span class="label">{cat.name}</span>}
      <Icon name="arrow" size={18} class="go" />
    </span>
  </a>
</li>

<style>
  .row {
    border-bottom: 1px solid var(--rule);
    list-style: none;
  }

  .row-link {
    display: grid;
    grid-template-columns: 8.5rem minmax(0, 1fr) auto;
    gap: 0.25rem 1.5rem;
    align-items: baseline;
    padding: 1.15rem 0.25rem;
    position: relative;
    transition: background 0.25s;
  }

  .row-link::before {
    content: '';
    position: absolute;
    inset: 0 auto 0 0;
    width: 2px;
    background: var(--sky);
    transform: scaleY(0);
    transition: transform 0.3s var(--ease);
  }

  .row-link:hover {
    background: linear-gradient(90deg, var(--paper-2), transparent);
  }

  .row-link:hover::before {
    transform: scaleY(1);
  }

  .meta {
    display: flex;
    gap: 0.75rem;
    font-family: var(--font-mono);
    font-size: 0.78rem;
    color: var(--ink-3);
    padding-left: 0.5rem;
  }

  .num {
    color: var(--sky);
  }

  .main {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
  }

  .title {
    font-size: 1.32rem;
    line-height: 1.4;
    color: var(--ink);
    transition: color 0.2s;
  }

  .row-link:hover .title {
    color: var(--sky-ink);
  }

  .summary {
    font-size: 0.92rem;
    color: var(--ink-2);
    line-height: 1.6;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .side {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }

  .side .series {
    color: var(--sky);
  }

  .go {
    color: var(--ink-3);
    transform: translateX(-6px);
    opacity: 0;
    transition: transform 0.3s var(--ease), opacity 0.3s;
  }

  .row-link:hover .go {
    transform: none;
    opacity: 1;
    color: var(--sky);
  }

  @media (max-width: 720px) {
    .row-link {
      grid-template-columns: minmax(0, 1fr);
      padding-block: 1rem;
    }
    .meta {
      padding-left: 0;
    }
    .side {
      order: -1;
      display: none;
    }
    .title {
      font-size: 1.2rem;
    }
  }
</style>
