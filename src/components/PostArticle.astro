---
// One article, laid out in full. Used by the public post page and by the
// endministrator's preview of unpublished work.
import '@/styles/prose.css';
import Base from '@/layouts/Base.astro';
import Toc from '@/components/Toc.astro';
import SeriesNav from '@/components/SeriesNav.astro';
import Comments from '@/components/Comments.astro';
import { categoryOf, categoryUrl, fmtDate, postNumbers, postUrl, relatedPosts, tagUrl, type Post, type PostWithBody } from '@/lib/posts';

interface Props {
  post: PostWithBody;
  /** The posts the viewer can see, for the pager, the series box and related posts. */
  all: Post[];
  /** Showing unpublished work: no comments, and a note saying so. */
  preview?: boolean;
  /** Where the endministrator edits this post. Shown only to them. */
  editHref?: string;
}
const { post, all, preview = false, editHref } = Astro.props;

const at = all.findIndex((p) => p.id === post.id);
const newer = at > 0 ? all[at - 1] : undefined;
const older = at >= 0 ? all[at + 1] : undefined;
const { headings, words, minutes } = post;
const { title, summary, date, updated, tags, series, cover, hidden } = post.data;
const cat = categoryOf(post);
const seriesPosts = series ? all.filter((p) => p.data.series === series || p.id === post.id) : [];
const related = relatedPosts(post, all);
const numbers = postNumbers();
// A draft has no number until it is published.
const number = numbers.get(post.id);
---

<Base
  title={title}
  description={summary}
  image={cover?.og}
  type="article"
  published={date}
  modified={updated}
  tags={tags}
  noindex={hidden || preview}
>
  <article class="spread" data-article data-pagefind-body>
    <div class="sheet">
      <header class="post-head">
        <p class="ids">
          {number && <a class="tag is-current" href="/posts/" title="回到文章列表">{number}</a>}
          {
            cat && (
              <a class="kv" href={categoryUrl(cat.slug)}>
                <span>分类</span>
                <span>{cat.name}</span>
              </a>
            )
          }
          {preview && <span class="badge-draft">预览，尚未发布</span>}
          {hidden && !preview && <span class="badge-draft">隐藏</span>}
          {editHref && <a class="edit mono" href={editHref}>编辑</a>}
        </p>
        <ul class="facts mono">
          <li><time datetime={date.toISOString()} data-pagefind-meta="date">{fmtDate(date)}</time></li>
          <li>{words.toLocaleString('zh-CN')} 字</li>
          <li>约 {minutes} 分钟</li>
          {updated && <li>更新 <time datetime={updated.toISOString()}>{fmtDate(updated)}</time></li>}
          {
            !preview && (
              <li data-views hidden data-pagefind-ignore>
                阅读 <span data-views-n /> 次
              </li>
            )
          }
        </ul>
        {cat && <span hidden data-pagefind-meta="category">{cat.name}</span>}
        <h1 class="title" data-pagefind-meta="title">{title}</h1>
        <div class="tri" aria-hidden="true"><i></i><i></i><i></i></div>
        {summary && <p class="summary">{summary}</p>}
        {
          tags.length > 0 && (
            <ul class="tags" aria-label="标签">
              {tags.map((t) => (
                <li>
                  <a class="chip" href={tagUrl(t)} data-pagefind-filter="tag">
                    {t}
                  </a>
                </li>
              ))}
            </ul>
          )
        }
        {
          cover && (
            <figure class="cover">
              <img src={cover.src} srcset={cover.srcset} sizes="(max-width: 760px) 94vw, 40rem" width={cover.width} height={cover.height} alt="" loading="eager" decoding="async" />
            </figure>
          )
        }
      </header>

      {series && <SeriesNav series={series} posts={seriesPosts} current={post} />}
      <div class="prose">
        <Fragment set:html={post.html} />
      </div>

      <footer class="post-foot" data-pagefind-ignore>
        <nav class="pager" aria-label="上一篇和下一篇">
          {
            older ? (
              <a href={postUrl(older)}>
                <span class="mono">上一篇 {numbers.get(older.id)}</span>
                <span class="name">{older.data.title}</span>
              </a>
            ) : (
              <span />
            )
          }
          {
            newer && (
              <a href={postUrl(newer)} class="next">
                <span class="mono">下一篇 {numbers.get(newer.id)}</span>
                <span class="name">{newer.data.title}</span>
              </a>
            )
          }
        </nav>
        {
          related.length > 0 && (
            <section class="related">
              <h2>相关文章</h2>
              <ul class="records">
                {related.map((p) => (
                  <li>
                    <a class="record" href={postUrl(p)}>
                      <span class="tag">{numbers.get(p.id)}</span>
                      <time class="mono" datetime={p.data.date.toISOString()}>{fmtDate(p.data.date)}</time>
                      <span class="name">{p.data.title}</span>
                      <span class="mono">{p.words.toLocaleString('zh-CN')} 字</span>
                    </a>
                  </li>
                ))}
              </ul>
            </section>
          )
        }
        {post.data.comments && !preview && <Comments slug={post.id} />}
      </footer>
    </div>

    <aside class="margin" data-pagefind-ignore>
      <div class="sticky">
        <Toc headings={headings} />
        <p class="jumps mono">
          <button type="button" data-to-top>回到顶部</button>
          {post.data.comments && !preview && <a href="#comments">留言</a>}
        </p>
      </div>
    </aside>
  </article>
</Base>

<style>
  .post-head {
    padding-bottom: 2rem;
  }

  .ids {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem;
    margin: 0 0 0.75rem;
  }

  .ids .badge-draft {
    margin: 0;
  }

  .edit {
    margin-left: auto;
    border-bottom: 1px solid var(--rule);
  }

  .edit:hover {
    color: var(--ink);
    border-color: var(--ink);
  }

  .title {
    margin: 1.5rem 0 1rem;
    font-size: clamp(var(--t-title), 5.5vw, var(--t-h1));
    line-height: 1.25;
    text-wrap: pretty;
  }

  .summary {
    margin: 1.25rem 0 0;
    font-size: var(--t-body);
    line-height: 1.75;
    color: var(--ink-2);
  }

  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    list-style: none;
    margin: 1.25rem 0 0;
    padding: 0;
  }

  .cover {
    margin: 2rem 0 0;
  }

  .cover img {
    display: block;
    width: 100%;
    max-height: 22rem;
    object-fit: cover;
    border: 1px solid var(--rule);
  }

  .sticky {
    position: sticky;
    top: 2rem;
    max-width: 18rem;
  }

  .jumps {
    display: flex;
    gap: 1.25rem;
    margin: 1.5rem 0 0;
  }

  .jumps button {
    padding: 0;
    border: 0;
    background: none;
    font: inherit;
    color: inherit;
  }

  .jumps :is(a, button):hover {
    color: var(--ink);
  }

  .post-foot {
    margin-top: 4rem;
  }

  .pager {
    display: grid;
    grid-template-columns: 1fr 1fr;
    border-top: 1px solid var(--ink);
    border-bottom: 1px solid var(--rule);
  }

  .pager a {
    display: flex;
    flex-direction: column;
    gap: 0.3rem;
    padding: 1rem 1rem 1.1rem 0;
    transition: background-color 0.15s;
  }

  .pager a:hover {
    background: var(--paper);
  }

  .pager .name {
    font-size: var(--t-body);
    line-height: 1.5;
  }

  .pager .next {
    grid-column: 2;
    padding-left: 1rem;
    border-left: 1px solid var(--rule);
  }

  .related {
    margin-top: 3rem;
  }

  .related h2 {
    margin: 0 0 0.75rem;
    font-size: var(--t-h2);
  }

  @media (max-width: 959px) {
    .margin {
      display: none;
    }
  }

  @media (max-width: 560px) {
    .pager {
      grid-template-columns: 1fr;
    }
    .pager .next {
      grid-column: 1;
      padding-left: 0;
      border-left: 0;
      border-top: 1px solid var(--rule);
    }
  }
</style>
