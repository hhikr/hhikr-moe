---
import type { MarkdownHeading } from 'astro';

interface Props {
  headings: MarkdownHeading[];
}

const all = Astro.props.headings.filter((h) => h.depth <= 4 && h.text.trim());
const top = Math.min(...all.map((h) => h.depth));
const items = all.filter((h) => h.depth <= top + 1);
---

{
  items.length > 1 && (
    <nav class="toc" aria-label="目录">
      <p class="label">目录 · Contents</p>
      <ol data-toc>
        {items.map((h) => (
          <li class:list={[{ sub: h.depth > top }]}>
            <a href={`#${h.slug}`}>{h.text}</a>
          </li>
        ))}
      </ol>
    </nav>
  )
}

<style>
  .toc .label {
    margin: 0 0 0.75rem;
  }

  ol {
    list-style: none;
    margin: 0;
    padding: 0;
    max-height: calc(100dvh - 12rem);
    overflow-y: auto;
    scrollbar-width: thin;
    border-left: 1px solid var(--rule);
  }

  li a {
    display: block;
    padding: 0.28rem 0 0.28rem 0.9rem;
    margin-left: -1px;
    border-left: 2px solid transparent;
    font-size: 0.86rem;
    line-height: 1.45;
    color: var(--ink-3);
    transition: color 0.2s, border-color 0.2s;
  }

  li.sub a {
    padding-left: 1.7rem;
    font-size: 0.8rem;
  }

  li a:hover {
    color: var(--ink);
  }

  li a:global(.active) {
    color: var(--sky-ink);
    border-left-color: var(--sky);
  }
</style>
