---
import Base from '../../layouts/Base.astro';
import { catalog, categoryLabels, exampleText, lessons } from '../../lib/hot100/curriculum.mjs';
import { lessonView } from '../../lib/hot100/lesson-view.mjs';

interface Props {
  id: number;
}

const { id } = Astro.props;
const index = catalog.findIndex((q) => q.id === id);
const question = catalog[index];
const lesson = (lessons as Record<number, (typeof lessons)[keyof typeof lessons] | undefined>)[id];
if (!question || !lesson) throw new Error(`Hot 100 lesson ${id} is missing from the curriculum.`);
const view = lessonView(question, lesson, {
  index,
  total: catalog.length,
  label: (categoryLabels as Record<string, string>)[question.category] ?? question.category,
  prev: catalog[index - 1] ?? null,
  next: catalog[index + 1] ?? null,
  example: exampleText(lesson),
});
---
<Base title={`${question.title} · Hot 100`} description={lesson.description}>
<link slot="head" rel="stylesheet" href="/hot100-assets/style.css" />
<div class="hot100" data-judge="/api/hot100"data-lesson={String(id)} data-pagefind-body set:html={view}></div>
<script is:inline type="module" src="/hot100-assets/app.mjs"></script>
</Base>

<script>
  // The practice editor (Monaco) is a few megabytes, so it loads only when the reader opens
  // the practice tab. app.mjs is a plain module outside the bundle; this is its way in.
  let loading: Promise<typeof import('../../scripts/hot100/editor')> | undefined;
  (window as unknown as { hot100LoadEditor: () => typeof loading }).hot100LoadEditor = () =>
    (loading ??= import('../../scripts/hot100/editor'));
</script>
