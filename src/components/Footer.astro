---
import { AUTHOR, SITE, SOCIALS } from '@/site.config';

const year = new Date().getFullYear();
---

<footer class="site-footer mono">
  <span>© {SITE.since}–{year} {AUTHOR.name}</span>
  <ul class="facts">
    <li><a href="/about/">关于</a></li>
    <li><a href="/tags/">标签</a></li>
    <li><a href="/rss.xml">RSS</a></li>
    <li><a href="/privacy/">隐私</a></li>
    {
      SOCIALS.map((s) => (
        <li>
          <a href={s.href} target="_blank" rel="noopener noreferrer me">
            {s.label}
          </a>
        </li>
      ))
    }
  </ul>
  <button type="button" class="top" data-to-top>回到顶部</button>
</footer>

<style>
  .site-footer {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem 1.5rem;
    padding: 1rem var(--pad);
    border-top: 1px solid var(--rule);
  }

  .site-footer a:hover,
  .top:hover {
    color: var(--ink);
  }

  .top {
    margin-left: auto;
    padding: 0;
    border: 0;
    background: none;
    font: inherit;
    color: inherit;
  }
</style>
