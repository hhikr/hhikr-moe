---
import Icon from './Icon.astro';
import { AUTHOR, NAV, SITE, SOCIALS } from '@/site.config';
import { fmtDate } from '@/lib/posts';

const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="wrap">
    <div class="cols">
      <div>
        <p class="label">Index</p>
        <ul>
          <li><a href="/">首页</a></li>
          {NAV.map((n) => <li><a href={n.href}>{n.label}</a></li>)}
          <li><a href="/categories/">分类</a></li>
        </ul>
      </div>
      <div>
        <p class="label">Elsewhere</p>
        <ul>
          {
            SOCIALS.map((s) => (
              <li>
                <a href={s.href} target="_blank" rel="noopener noreferrer me">
                  <Icon name={s.icon} size={15} /> {s.label}
                </a>
              </li>
            ))
          }
        </ul>
      </div>
      <div>
        <p class="label">Subscribe</p>
        <ul>
          <li><a href="/rss.xml"><Icon name="rss" size={15} /> RSS</a></li>
          <li><a href="/sitemap-index.xml"><Icon name="list" size={15} /> Sitemap</a></li>
        </ul>
      </div>
    </div>

    <div class="colophon">
      <span>© {SITE.since}–{year} {AUTHOR.name}</span>
      <span>Built with <a href="https://astro.build" target="_blank" rel="noopener">Astro</a> · {fmtDate(new Date())}</span>
      <button type="button" class="top" data-to-top aria-label="回到顶部"><Icon name="up" size={16} /></button>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    margin-top: clamp(4rem, 10vw, 8rem);
    padding-block: 3rem 1.5rem;
    border-top: 1.5px solid var(--rule-strong);
    background: var(--paper-2);
  }





  .cols {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 2rem;
    padding-block: 2.25rem;
  }

  .cols ul {
    list-style: none;
    margin: 0.75rem 0 0;
    padding: 0;
    display: grid;
    gap: 0.3rem;
  }

  .cols a {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    color: var(--ink-2);
    font-size: 0.95rem;
    transition: color 0.2s;
  }

  .cols a:hover {
    color: var(--sky);
  }

  .colophon {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem 1.5rem;
    padding-top: 1.25rem;
    border-top: 1px solid var(--rule);
    font-family: var(--font-mono);
    font-size: 0.72rem;
    color: var(--ink-3);
  }

  .colophon a {
    border-bottom: 1px solid var(--rule);
  }

  .colophon a:hover {
    color: var(--sky);
  }

  .top {
    margin-left: auto;
    display: grid;
    place-items: center;
    width: 2.2rem;
    height: 2.2rem;
    border: 1px solid var(--rule);
    border-radius: 999px;
    background: var(--paper);
    cursor: pointer;
    color: var(--ink-2);
    transition: color 0.2s, border-color 0.2s, transform 0.3s var(--ease);
  }

  .top:hover {
    color: var(--sky);
    border-color: var(--sky);
    transform: translateY(-3px);
  }

  @media (max-width: 560px) {
    .cols {
      grid-template-columns: 1fr 1fr;
    }
  }
</style>
