---
import Icon from './Icon.astro';
import { NAV } from '@/site.config';
---

<dialog class="search" data-search aria-label="搜索">
  <div class="panel">
    <div class="field">
      <Icon name="search" size={18} />
      <input type="search" placeholder="搜索文章、笔记、标签…" autocomplete="off" spellcheck="false" data-search-input aria-label="搜索关键词" />
      <button type="button" class="esc" data-search-close>Esc</button>
    </div>
    <div class="body" data-search-body>
      <div class="quick" data-search-quick>
        <p class="label">快速跳转</p>
        <ul>
          <li><a href="/">首页 <span class="display">Home</span></a></li>
          {NAV.map((n) => <li><a href={n.href}>{n.label} <span class="display">{n.en}</span></a></li>)}
          <li><a href="/categories/">分类 <span class="display">Categories</span></a></li>
          <li><a href="/rss.xml">RSS 订阅 <span class="display">Feed</span></a></li>
        </ul>
      </div>
      <p class="status label" data-search-status hidden></p>
      <ol class="results" data-search-results></ol>
    </div>
    <div class="foot label">
      <span><kbd>↑</kbd><kbd>↓</kbd> 选择</span>
      <span><kbd>↵</kbd> 打开</span>
      <span class="pf">Pagefind 全文检索</span>
    </div>
  </div>
</dialog>

<style>
  .search {
    width: min(42rem, calc(100vw - 2rem));
    max-height: min(36rem, calc(100dvh - 6rem));
    margin: 12vh auto auto;
    padding: 0;
    border: 1px solid var(--rule-strong);
    border-radius: 6px;
    background: var(--paper);
    color: var(--ink);
    box-shadow: 8px 8px 0 var(--sky-soft), var(--shadow);
    overflow: hidden;
  }

  .search[open] {
    display: flex;
    animation: pop 0.25s var(--ease);
  }

  .search::backdrop {
    background: color-mix(in srgb, var(--paper) 40%, rgb(10 12 18 / 0.45));
    backdrop-filter: blur(3px);
  }

  @keyframes pop {
    from {
      opacity: 0;
      transform: translateY(8px) scale(0.985);
    }
  }

  .panel {
    display: flex;
    flex-direction: column;
    width: 100%;
    min-height: 0;
  }

  .field {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 0 1rem;
    border-bottom: 1px solid var(--rule);
    color: var(--ink-3);
  }

  .field input {
    flex: 1;
    min-width: 0;
    height: 3.5rem;
    border: 0;
    outline: 0;
    background: none;
    font: inherit;
    font-size: 1.1rem;
    color: var(--ink);
  }

  .field input::-webkit-search-cancel-button {
    display: none;
  }

  .esc {
    padding: 0.15rem 0.45rem;
    border: 1px solid var(--rule);
    border-radius: 3px;
    background: none;
    font-family: var(--font-mono);
    font-size: 0.7rem;
    color: var(--ink-3);
    cursor: pointer;
  }

  .body {
    flex: 1;
    overflow-y: auto;
    padding: 0.75rem;
    overscroll-behavior: contain;
  }

  .quick .label {
    padding: 0.25rem 0.5rem 0.5rem;
    margin: 0;
  }

  .quick ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: 1fr 1fr;
  }

  .quick a {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    padding: 0.55rem 0.6rem;
    border-radius: 4px;
    font-family: var(--font-cjk);
  }

  .quick a .display {
    font-style: italic;
    color: var(--ink-3);
  }

  .quick a:hover,
  .quick a:focus-visible {
    background: var(--paper-2);
    outline: none;
  }

  .status {
    margin: 0.5rem;
  }

  .results {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .results :global(a) {
    display: block;
    padding: 0.75rem 0.8rem;
    border-radius: 4px;
    border-left: 2px solid transparent;
  }

  .results :global(a[aria-selected='true']),
  .results :global(a:hover) {
    background: var(--paper-2);
    border-left-color: var(--sky);
  }

  .results :global(.r-title) {
    font-family: var(--font-cjk);
    font-size: 1.08rem;
  }

  .results :global(.r-excerpt) {
    margin-top: 0.2rem;
    font-size: 0.86rem;
    line-height: 1.6;
    color: var(--ink-2);
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .results :global(mark) {
    background: var(--mark);
    color: var(--sky-ink);
    padding: 0 0.1em;
  }

  .results :global(.r-sub) {
    display: block;
    margin-top: 0.3rem;
    font-family: var(--font-mono);
    font-size: 0.7rem;
    color: var(--ink-3);
  }

  .foot {
    display: flex;
    gap: 1.25rem;
    padding: 0.6rem 1rem;
    border-top: 1px solid var(--rule);
    background: var(--paper-2);
  }

  .foot kbd {
    font-family: inherit;
    padding: 0 0.3em;
    border: 1px solid var(--rule);
    border-radius: 2px;
    margin-right: 0.2em;
  }

  .foot .pf {
    margin-left: auto;
  }

  @media (max-width: 560px) {
    .search {
      margin-top: 1rem;
    }
    .foot span:not(.pf) {
      display: none;
    }
    .quick ul {
      grid-template-columns: 1fr;
    }
  }
</style>
