---
import Icon from './Icon.astro';
import { NAV } from '@/site.config';
---

<dialog class="search" data-search aria-label="搜索">
  <div class="panel">
    <div class="field">
      <Icon name="search" size={18} />
      <input type="search" placeholder="搜索文章、笔记、标签…" autocomplete="off" spellcheck="false" data-search-input aria-label="搜索关键词" />
      <button type="button" class="esc" data-search-close>Esc</button>
    </div>
    <div class="body" data-search-body>
      <div class="quick" data-search-quick>
        <p class="label">快速跳转</p>
        <ul>
          <li><a href="/">首页 <span class="en">Home</span></a></li>
          {NAV.map((n) => <li><a href={n.href}>{n.label} <span class="en">{n.en}</span></a></li>)}
          <li><a href="/tags/">标签 <span class="en">Tags</span></a></li>
          <li><a href="/rss.xml">RSS 订阅 <span class="en">Feed</span></a></li>
        </ul>
      </div>
      <p class="status label" data-search-status hidden></p>
      <ol class="results" data-search-results></ol>
    </div>
    <div class="foot label">
      <span><kbd>↑</kbd><kbd>↓</kbd> 选择</span>
      <span><kbd>↵</kbd> 打开</span>
      <span class="pf">Pagefind 全文检索</span>
    </div>
  </div>
</dialog>

<style>
  /* The same plate as the sign-in box: ink edge, a heavy tab along the top. */
  .search {
    width: min(42rem, calc(100vw - 2rem));
    max-height: min(36rem, calc(100dvh - 6rem));
    margin: 12vh auto auto;
    padding: 0;
    border: 1px solid var(--ink);
    border-top-width: 5px;
    background: var(--panel);
    color: var(--ink);
    font-family: var(--font-ui);
    overflow: hidden;
  }

  .search[open] {
    display: flex;
  }

  @media (prefers-reduced-motion: no-preference) {
    .search[open] {
      animation: drop 0.28s var(--mech);
    }
    @keyframes drop {
      from {
        clip-path: inset(0 0 100% 0);
      }
      to {
        clip-path: inset(0);
      }
    }
  }

  .search::backdrop {
    background: color-mix(in srgb, var(--paper) 55%, rgb(10 10 10 / 0.5));
  }

  .panel {
    display: flex;
    flex-direction: column;
    width: 100%;
    min-height: 0;
  }

  .field {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 0 1rem;
    border-bottom: 1px solid var(--ink);
    color: var(--ink-2);
  }

  .field input {
    flex: 1;
    min-width: 0;
    height: 3.5rem;
    border: 0;
    outline: 0;
    background: none;
    font: inherit;
    font-size: 1.1rem;
    color: var(--ink);
  }

  .field input::-webkit-search-cancel-button {
    display: none;
  }

  .esc {
    padding: 0.1rem 0.5rem;
    border: 0;
    background: var(--chip);
    font-family: var(--font-mono);
    font-size: 0.7rem;
    color: var(--ink-2);
    cursor: pointer;
  }

  .esc:hover {
    background: var(--signal);
    color: var(--on-signal);
  }

  .body {
    flex: 1;
    overflow-y: auto;
    padding: 0.75rem;
    overscroll-behavior: contain;
  }

  .quick .label {
    padding: 0.25rem 0.5rem 0.5rem;
    margin: 0;
  }

  .quick ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 2px;
  }

  .quick a {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    padding: 0.55rem 0.7rem;
    background: var(--paper);
    font-weight: 600;
  }

  .quick a .en {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    font-weight: 400;
    color: var(--ink-2);
  }

  .quick a:hover,
  .quick a:focus-visible {
    background: var(--signal);
    color: var(--on-signal);
    outline: none;
  }

  .quick a:hover .en,
  .quick a:focus-visible .en {
    color: var(--on-signal);
  }

  .status {
    margin: 0.5rem;
  }

  .results {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .results :global(a) {
    display: block;
    padding: 0.75rem 0.8rem;
    border-left: 4px solid transparent;
    border-bottom: 1px solid var(--rule);
  }

  .results :global(a[aria-selected='true']),
  .results :global(a:hover) {
    background: var(--paper);
    border-left-color: var(--trace);
  }

  /* a result's title is a post's, so it is in the reading face */
  .results :global(.r-title) {
    font-family: var(--font-text);
    font-size: 1.08rem;
  }

  .results :global(.r-excerpt) {
    margin-top: 0.2rem;
    font-family: var(--font-text);
    font-size: 0.9rem;
    line-height: 1.6;
    color: var(--ink-2);
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .results :global(mark) {
    background: var(--mark);
    color: var(--ink);
    padding: 0 0.1em;
  }

  .results :global(.r-sub) {
    display: block;
    margin-top: 0.3rem;
    font-family: var(--font-mono);
    font-size: 0.7rem;
    color: var(--ink-2);
  }

  .foot {
    display: flex;
    gap: 1.25rem;
    padding: 0.6rem 1rem;
    border-top: 1px solid var(--rule);
    background: var(--paper);
  }

  .foot kbd {
    font-family: inherit;
    padding: 0 0.3em;
    background: var(--chip);
    margin-right: 0.2em;
  }

  .foot .pf {
    margin-left: auto;
  }

  @media (max-width: 560px) {
    .search {
      margin-top: 1rem;
    }
    .foot span:not(.pf) {
      display: none;
    }
    .quick ul {
      grid-template-columns: 1fr;
    }
  }
</style>
