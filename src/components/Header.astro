---
import Icon from './Icon.astro';
import { NAV } from '@/site.config';

const path = Astro.url.pathname;
const isActive = (href: string) => path === href || (href !== '/' && path.startsWith(href));
// Only the endministrator's own (uncached) pages carry this link.
const endmin = Astro.locals.viewer?.role === 'endmin';
const items = [{ label: '首页', href: '/' }, ...NAV];
---

<!-- A rail down the left on a wide screen, a bar across the top otherwise. -->
<header class="site-header" data-header>
  <a href="/" class="brand" aria-label="hhikr.moe 首页">HHIKR.MOE</a>

  <nav class="nav" id="site-nav" aria-label="主导航">
    {
      items.map((item) => (
        <a href={item.href} class:list={['nav-link', { active: isActive(item.href) }]} aria-current={isActive(item.href) ? 'page' : undefined}>
          {item.label}
        </a>
      ))
    }
  </nav>

  <div class="tools">
    {endmin && <a class="tool" href="/endmin/"><span class="word">管理</span></a>}
    <button class="tool" type="button" data-search-open aria-label="搜索 (Ctrl K)">
      <Icon name="search" size={16} />
      <span class="word">搜索</span>
      <kbd class="mono" data-kbd>Ctrl K</kbd>
    </button>
    <button class="tool" type="button" data-theme-toggle aria-label="切换主题">
      <Icon name="sun" size={16} class="i-light" />
      <Icon name="moon" size={16} class="i-dark" />
      <Icon name="auto" size={16} class="i-auto" />
      <span class="word">主题</span>
    </button>
    <button class="tool menu-btn" type="button" data-menu-toggle aria-label="菜单" aria-expanded="false" aria-controls="site-nav">
      <Icon name="menu" size={18} />
    </button>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    align-self: start;
    display: flex;
    flex-direction: column;
    height: 100dvh;
    padding: 1.5rem 0 1rem;
    background: var(--paper);
    border-right: 1px solid var(--rule);
    font-family: var(--font-ui);
  }

  .brand {
    padding: 0 1.25rem;
    font-family: var(--font-mono);
    font-size: var(--t-mono);
    letter-spacing: 0.04em;
  }

  .nav {
    display: flex;
    flex-direction: column;
    margin-top: 2rem;
  }

  .nav-link {
    padding: 0.4rem 1.25rem;
    color: var(--ink-2);
    transition: color 0.15s;
  }

  .nav-link:hover {
    color: var(--ink);
  }

  /* On the rail, pointing at a section draws a short lead-in and steps it across. */
  @media (min-width: 1100px) and (prefers-reduced-motion: no-preference) {
    .nav-link {
      position: relative;
      transition:
        color 0.15s,
        padding-left 0.25s var(--snap);
    }
    .nav-link:not(.active)::before {
      content: '';
      position: absolute;
      left: 0;
      top: 50%;
      width: 0.7rem;
      height: 2px;
      background: var(--ink);
      transform: scaleX(0);
      transform-origin: left;
      transition: transform 0.2s var(--snap);
    }
    .nav-link:not(.active):hover {
      padding-left: 1.7rem;
    }
    .nav-link:not(.active):hover::before {
      transform: none;
    }
  }

  /* The yellow block is "where you are". It carries a name so that it slides
     to its new place when the page changes. */
  .nav-link.active {
    color: var(--on-signal);
    background: linear-gradient(-45deg, transparent calc(var(--cut) - 0.5px), var(--signal) var(--cut));
    view-transition-name: nav-current;
  }

  .tools {
    display: flex;
    flex-direction: column;
    margin-top: 1.5rem;
    padding-top: 1rem;
    border-top: 1px solid var(--rule);
  }

  .tool {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    padding: 0.4rem 1.25rem;
    border: 0;
    background: none;
    color: var(--ink-2);
    text-align: left;
    transition: color 0.15s;
  }

  .tool:hover {
    color: var(--ink);
  }

  .tool kbd {
    margin-left: auto;
    font-size: 0.7rem;
  }

  .tool :global(svg) {
    flex: none;
  }

  [data-theme-toggle] :global(.i-light),
  [data-theme-toggle] :global(.i-dark),
  [data-theme-toggle] :global(.i-auto) {
    display: none;
  }

  :global(:root[data-theme-pref='light']) [data-theme-toggle] :global(.i-light),
  :global(:root[data-theme-pref='dark']) [data-theme-toggle] :global(.i-dark),
  :global(:root[data-theme-pref='auto']) [data-theme-toggle] :global(.i-auto) {
    display: block;
  }

  .menu-btn {
    display: none;
  }

  /* ---- a bar across the top ---- */
  @media (max-width: 1099px) {
    .site-header {
      flex-direction: row;
      align-items: stretch;
      height: 3.5rem;
      padding: 0 0 0 var(--pad);
      border-right: 0;
      border-bottom: 1px solid var(--rule);
    }

    .brand {
      display: flex;
      align-items: center;
      padding: 0;
    }

    .nav {
      flex-direction: row;
      margin: 0 auto 0 1.5rem;
    }

    .nav-link {
      display: flex;
      align-items: center;
      padding: 0 0.9rem;
    }

    .tools {
      flex-direction: row;
      margin: 0;
      padding: 0 calc(var(--pad) - 0.75rem) 0 0;
      border: 0;
    }

    .tool {
      justify-content: center;
      min-width: 2.75rem;
      padding: 0 0.75rem;
    }

    .tool kbd {
      display: none;
    }

    .tool :global(svg) + .word {
      display: none;
    }
  }

  /* ---- a phone: the nav folds into six cells under the bar ---- */
  @media (max-width: 719px) {
    .site-header {
      flex-wrap: wrap;
      height: auto;
      padding-left: 0;
    }

    .brand {
      height: 3.5rem;
      margin-right: auto;
      padding-left: var(--pad);
    }

    .tools {
      height: 3.5rem;
    }

    .menu-btn {
      display: flex;
    }

    .nav {
      order: 3;
      display: none;
      width: 100%;
      margin: 0;
      grid-template-columns: repeat(3, 1fr);
      gap: 1px;
      background: var(--rule);
      border-top: 1px solid var(--rule);
    }

    .site-header[data-nav-open] .nav {
      display: grid;
    }

    .nav-link {
      justify-content: center;
      min-height: 3rem;
      padding: 0;
      background: var(--paper);
    }

    .nav-link.active {
      background: var(--signal);
    }

    /* Six cells, as planned; 关于 is in the footer on a phone. */
    .nav-link:nth-child(n + 7) {
      display: none;
    }
  }
</style>
