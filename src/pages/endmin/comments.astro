---
import Endmin from '@/layouts/Endmin.astro';
import { listAllComments, moderatingFirstComments } from '@/server/comments.ts';

export const prerender = false;

const comments = listAllComments(300);
const moderating = moderatingFirstComments();
const when = new Intl.DateTimeFormat('zh-CN', { timeZone: 'Asia/Shanghai', year: 'numeric', month: '2-digit', day: '2-digit', hour: '2-digit', minute: '2-digit', hour12: false });
const hidden = comments.filter((c) => c.status === 'hidden').length;
---

<Endmin title="评论" en="Comments" lead="隐藏的评论只有作者本人和你能看到。删除后无法恢复。">
  <div class="em-filters" data-filters role="toolbar" aria-label="按状态筛选">
    <button type="button" class="chip" data-filter="all" aria-pressed="true">全部 {comments.length}</button>
    <button type="button" class="chip" data-filter="hidden" aria-pressed="false">隐藏与待审 {hidden}</button>
    <button type="button" class="chip" data-filter="visible" aria-pressed="false">公开 {comments.length - hidden}</button>
    <label class="em-switch">
      <input type="checkbox" data-moderate checked={moderating} />
      新用户的第一条评论先审核
    </label>
  </div>

  {
    comments.length === 0 ? (
      <p class="em-empty">还没有评论。</p>
    ) : (
      <ul class="em-rows">
        {comments.map((c) => (
          <li data-group={c.status}>
            <div class="em-meta">
              <span>{c.author?.handle ?? '已删除的用户'}</span>
              <span>{when.format(new Date(c.createdAt))}</span>
              <a href={`/posts/${c.postSlug}/#comment-${c.id}`}>{c.postTitle}</a>
              {c.parentId && <span>回复</span>}
              {c.status === 'hidden' && <span class="em-state hidden">隐藏</span>}
            </div>
            <div class="em-acts">
              {c.status === 'hidden' ? (
                <button class="em-btn go" data-api={`/api/endmin/comments/${c.id}`} data-body='{"status":"visible"}'>
                  公开
                </button>
              ) : (
                <button class="em-btn" data-api={`/api/endmin/comments/${c.id}`} data-body='{"status":"hidden"}'>
                  隐藏
                </button>
              )}
              <button class="em-btn danger" data-api={`/api/endmin/comments/${c.id}`} data-method="DELETE" data-confirm="删除这条评论？删除后无法恢复。">
                删除
              </button>
            </div>
            <div class="em-quote" set:html={c.html} />
          </li>
        ))}
      </ul>
    )
  }
</Endmin>

<script>
  import { api } from '@/scripts/account';

  const box = document.querySelector<HTMLInputElement>('[data-moderate]');
  box?.addEventListener('change', async () => {
    const res = await api('/api/endmin/settings', { moderateFirstComment: box.checked }, 'PATCH');
    if (!res.ok) box.checked = !box.checked;
  });
</script>
