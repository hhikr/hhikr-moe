---
import Endmin from '@/layouts/Endmin.astro';
import { fmtDate } from '@/lib/posts';
import { CATEGORIES } from '@/site.config';
import { listAllPosts, type PostSummary } from '@/server/posts.ts';

export const prerender = false;

const posts = listAllPosts();
const groupOf = (p: PostSummary) => (p.status === 'draft' ? 'draft' : p.hidden ? 'hidden' : 'published');
const LABEL = { published: '已发布', hidden: '隐藏', draft: '草稿' };
const count = (g: string) => posts.filter((p) => groupOf(p) === g).length;
const body = (o: object) => JSON.stringify(o);
---

<Endmin title="文章" en="Posts" lead="写新文章，或者编辑、发布、隐藏已有的文章。">
  <div class="em-filters" data-filters role="toolbar" aria-label="按状态筛选">
    <button type="button" class="chip" data-filter="all" aria-pressed="true">全部 {posts.length}</button>
    {
      (['published', 'hidden', 'draft'] as const).map((g) => (
        <button type="button" class="chip" data-filter={g} aria-pressed="false">
          {LABEL[g]} {count(g)}
        </button>
      ))
    }
    <button type="button" class="em-btn go new-post" data-new-post>写新文章</button>
  </div>

  <ul class="em-rows">
    {
      posts.map((p) => {
        const group = groupOf(p);
        return (
          <li data-group={group}>
            <div>
              <div class="t">
                <a href={`/endmin/posts/${p.id}/`}>{p.title}</a>
                <span class={`em-state ${group}`}>{LABEL[group]}</span>
              </div>
              <div class="em-meta">
                <span>{fmtDate(p.publishedAt)}</span>
                <span>{p.slug}</span>
                {p.category && <span>{CATEGORIES[p.category]?.name ?? p.category}</span>}
                {p.series && <span>{p.series.replace(/^笔记-/, '')}</span>}
                <span>{p.words.toLocaleString('zh-CN')} 字</span>
              </div>
            </div>
            <div class="em-acts">
              <a class="em-btn" href={`/endmin/posts/${p.id}/`}>编辑</a>
              {group !== 'draft' && <a class="em-btn" href={`/posts/${p.slug}/`}>查看</a>}
              {group === 'draft' && (
                <button class="em-btn go" data-api={`/api/endmin/posts/${p.id}`} data-body={body({ status: 'published' })} data-confirm={`发布「${p.title}」？所有人都能看到它。`}>
                  发布
                </button>
              )}
              {group === 'published' && (
                <button class="em-btn" data-api={`/api/endmin/posts/${p.id}`} data-body={body({ hidden: true })}>
                  隐藏
                </button>
              )}
              {group === 'hidden' && (
                <button class="em-btn go" data-api={`/api/endmin/posts/${p.id}`} data-body={body({ hidden: false })}>
                  取消隐藏
                </button>
              )}
              {group !== 'draft' && (
                <button class="em-btn danger" data-api={`/api/endmin/posts/${p.id}`} data-body={body({ status: 'draft' })} data-confirm={`把「${p.title}」撤回为草稿？它会从网站上消失，直到再次发布。`}>
                  撤回为草稿
                </button>
              )}
            </div>
          </li>
        );
      })
    }
  </ul>
</Endmin>

<script>
  import { api } from '@/scripts/account';

  document.querySelector('[data-new-post]')?.addEventListener('click', async () => {
    const res = await api('/api/endmin/posts', {});
    if (res.ok) location.assign(`/endmin/posts/${res.data.id}/`);
  });
</script>

<style>
  .new-post {
    margin-left: auto;
  }
</style>
