---
// One work: what it is, its files by version, pictures and change log.
import '@/styles/prose.css';
import Base from '@/layouts/Base.astro';
import { fmtDate, viewerOf } from '@/lib/posts';
import { getProject, projectPost, PROJECT_KINDS, type ProjectRelease } from '@/server/projects.ts';
import { formatBytes } from '@/server/system.ts';

export const prerender = false;

const viewer = viewerOf(Astro.locals);
const work = getProject(Astro.params.slug ?? '', viewer);
if (!work) return new Response(null, { status: 404 });
Astro.response.headers.set('Cache-Control', work.hidden ? 'private, no-store' : 'no-cache');

const post = projectPost(work.postId, viewer);
const latest = work.releases[0];
const withNotes = work.releases.filter((r) => r.notesHtml.trim());
const n = (value: number) => value.toLocaleString('zh-CN');
const editHref = viewer.role === 'endmin' ? `/endmin/works/${work.id}/` : undefined;

const parts = [
  { href: '#about', label: '介绍' },
  { href: '#files', label: '文件', count: work.fileCount },
  ...(work.images.length ? [{ href: '#images', label: '图片', count: work.images.length }] : []),
  ...(withNotes.length ? [{ href: '#log', label: '更新日志', count: withNotes.length }] : []),
];
const releases: { release: ProjectRelease; latest: boolean }[] = work.releases.map((release, i) => ({ release, latest: i === 0 }));
---

<Base title={work.title} description={work.summary} image={work.cover?.og} noindex={work.hidden}>
  <article class="spread" data-pagefind-body>
    <div class="sheet">
      <header class="work-head">
        <p class="crumb mono">
          <a href="/works/">全部作品</a>
          <span>作品</span>
        </p>
        <p class="ids">
          <span class="kv">
            <span>类型</span>
            <span>{PROJECT_KINDS[work.kind]}</span>
          </span>
          {latest && <span class="mono">{latest.version}</span>}
          {work.hidden && <span class="badge-draft">隐藏</span>}
          {editHref && <a class="edit mono" href={editHref}>编辑</a>}
        </p>
        <h1 class="title" data-pagefind-meta="title">{work.title}</h1>
        <ul class="facts mono" data-pagefind-ignore>
          <li>更新 <time datetime={work.updatedAt.toISOString()}>{fmtDate(work.updatedAt)}</time></li>
          {work.fileCount > 0 && <li>{work.fileCount} 个文件</li>}
          {work.fileCount > 0 && <li>下载 {n(work.downloads)} 次</li>}
        </ul>
        {work.summary && <p class="lede">{work.summary}</p>}

        <p class="actions" data-pagefind-ignore>
          {
            latest && latest.files.length === 1 ? (
              <a class="btn go" href={latest.files[0].url} download data-astro-prefetch="false">
                下载 {latest.version} <span class="no">{formatBytes(latest.files[0].size)}</span>
              </a>
            ) : (
              work.fileCount > 0 && (
                <a class="btn go" href="#files">
                  下载
                </a>
              )
            )
          }
          {
            post && (
              <a class="btn" href={`/posts/${post.slug}/`}>
                相关文章
              </a>
            )
          }
        </p>

        {
          work.cover && (
            <figure class="cover" data-zoom>
              <img src={work.cover.src} srcset={work.cover.srcset} sizes="(max-width: 760px) 94vw, 40rem" width={work.cover.width} height={work.cover.height} alt="" loading="eager" decoding="async" />
            </figure>
          )
        }
      </header>

      <section id="about" class="part">
        <div class="prose">{work.descriptionHtml.trim() ? <Fragment set:html={work.descriptionHtml} /> : <p class="quiet">还没有介绍。</p>}</div>
      </section>

      <section id="files" class="part" data-pagefind-ignore>
        <h2 class="group-head">
          <span>文件</span>
          <span class="mono">{work.fileCount} 个</span>
        </h2>
        {
          releases.length === 0 ? (
            <p class="empty">还没有可以下载的文件。</p>
          ) : (
            releases.map(({ release, latest: newest }) => {
              const list = (
                <>
                  {release.files.length === 0 ? (
                    <p class="quiet">这个版本还没有文件。</p>
                  ) : (
                    <ul class="files">
                      {release.files.map((f) => (
                        <li>
                          <div class="file">
                            <p class="fname">{f.filename}</p>
                            {f.note && <p class="fnote">{f.note}</p>}
                            <ul class="facts mono">
                              <li>{formatBytes(f.size)}</li>
                              <li>下载 {n(f.downloads)}</li>
                              <li title={`SHA-256: ${f.sha256}`}>SHA-256 {f.sha256.slice(0, 12)}…</li>
                            </ul>
                          </div>
                          <a class="btn small" href={f.url} download data-astro-prefetch="false">
                            下载
                          </a>
                        </li>
                      ))}
                    </ul>
                  )}
                </>
              );
              const head = (
                <>
                  <span class:list={['tag', { 'is-current': newest }]}>{release.version}</span>
                  <span class="mono">
                    {newest ? '最新 | ' : ''}
                    {fmtDate(release.createdAt)}
                  </span>
                </>
              );
              return newest ? (
                <div class="release">
                  <p class="rel-head">{head}</p>
                  {list}
                </div>
              ) : (
                <details class="release older">
                  <summary class="rel-head">{head}</summary>
                  {list}
                </details>
              );
            })
          )
        }
      </section>

      {
        work.images.length > 0 && (
          <section id="images" class="part" data-pagefind-ignore>
            <h2 class="group-head">
              <span>图片</span>
              <span class="mono">{work.images.length} 张</span>
            </h2>
            <ul class="gallery" data-zoom>
              {work.images.map((image) => (
                <li>
                  <img src={image.url} data-full={image.full} width={image.width} height={image.height} alt={`${work.title} 的图片`} loading="lazy" decoding="async" />
                </li>
              ))}
            </ul>
          </section>
        )
      }

      {
        withNotes.length > 0 && (
          <section id="log" class="part">
            <h2 class="group-head">
              <span>更新日志</span>
              <span class="mono">{withNotes.length} 条</span>
            </h2>
            {withNotes.map((release) => (
              <div class="entry">
                <p class="rel-head">
                  <span class="tag">{release.version}</span>
                  <span class="mono">{fmtDate(release.createdAt)}</span>
                </p>
                <div class="prose notes" set:html={release.notesHtml} />
              </div>
            ))}
          </section>
        )
      }
    </div>

    <aside class="margin" data-pagefind-ignore>
      <div class="sticky">
        <h2 class="margin-h mono">本页</h2>
        <ul class="ledger">
          {
            parts.map((part) => (
              <li>
                <a href={part.href}>{part.label}</a>
                {part.count !== undefined && <span class="mono">{part.count}</span>}
              </li>
            ))
          }
        </ul>
        {
          (work.links.length > 0 || post) && (
            <>
              <h2 class="margin-h mono">链接</h2>
              <ul class="ledger">
                {post && (
                  <li>
                    <a href={`/posts/${post.slug}/`}>{post.title}</a>
                    <span class="mono">文章</span>
                  </li>
                )}
                {work.links.map((link) => (
                  <li>
                    <a href={link.url} target="_blank" rel="noopener noreferrer">
                      {link.label}
                    </a>
                    <span class="mono">外部</span>
                  </li>
                ))}
              </ul>
            </>
          )
        }
      </div>
    </aside>
  </article>
</Base>

<style>
  .ids {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem 0.75rem;
    margin: 0 0 0.75rem;
  }

  .ids .badge-draft {
    margin: 0;
  }

  .edit {
    margin-left: auto;
    border-bottom: 1px solid var(--rule);
  }

  .edit:hover {
    color: var(--ink);
    border-color: var(--ink);
  }

  .title {
    margin: 1.25rem 0 1rem;
    font-size: clamp(var(--t-title), 5.5vw, var(--t-h1));
    line-height: 1.25;
    text-wrap: pretty;
  }

  .work-head .actions {
    margin-top: 1.5rem;
  }

  .cover {
    margin: 2rem 0 0;
    cursor: zoom-in;
  }

  .cover img {
    display: block;
    width: 100%;
    max-height: 26rem;
    object-fit: cover;
    border: 1px solid var(--rule);
  }

  .part {
    margin-top: 3rem;
  }

  .quiet {
    color: var(--ink-2);
  }

  .release + .release {
    margin-top: 1.5rem;
  }

  .rel-head {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem 0.9rem;
    margin: 1.25rem 0 0.5rem;
  }

  details.older > summary {
    list-style: none;
    cursor: pointer;
  }

  details.older > summary::-webkit-details-marker {
    display: none;
  }

  details.older > summary::after {
    content: '展开';
    margin-left: auto;
    font-family: var(--font-mono);
    font-size: var(--t-mono);
    color: var(--ink-2);
  }

  details.older[open] > summary::after {
    content: '收起';
  }

  .files {
    margin: 0;
    padding: 0;
    list-style: none;
    border-top: 1px solid var(--rule);
  }

  .files > li {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem 1.5rem;
    padding: 0.9rem 0;
    border-bottom: 1px solid var(--rule);
  }

  .file {
    min-width: 0;
  }

  .file p {
    margin: 0;
  }

  .fname {
    font-family: var(--font-mono);
    overflow-wrap: anywhere;
  }

  .fnote {
    margin-top: 0.2rem !important;
    color: var(--ink-2);
  }

  .file .facts {
    margin-top: 0.35rem;
  }

  .gallery {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 14rem), 1fr));
    gap: 0.75rem;
    margin: 1.25rem 0 0;
    padding: 0;
    list-style: none;
  }

  .gallery img {
    display: block;
    width: 100%;
    aspect-ratio: 16 / 10;
    object-fit: cover;
    border: 1px solid var(--rule);
    cursor: zoom-in;
  }

  .entry + .entry {
    margin-top: 1.5rem;
  }

  .notes {
    font-size: 0.97rem;
  }

  .sticky {
    position: sticky;
    top: 2rem;
  }

  .margin .ledger a {
    overflow-wrap: anywhere;
  }
</style>
