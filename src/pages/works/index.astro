---
import Base from '@/layouts/Base.astro';
import { fmtDate, viewerOf } from '@/lib/posts';
import { listProjects, PROJECT_KINDS } from '@/server/projects.ts';

export const prerender = false;

const works = listProjects(viewerOf(Astro.locals));
Astro.response.headers.set('Cache-Control', works.some((w) => w.hidden) ? 'private, no-store' : 'no-cache');
---

<Base title="作品" description="hhikr 做的 mod 和其他可以下载的东西。">
  <div class="wrap">
    <header class="page-head">
      <p class="label kicker">Works · {works.length}</p>
      <h1>作品<span class="en">Works</span></h1>
    </header>

    {
      works.length === 0 ? (
        <p class="none">还没有发布作品。</p>
      ) : (
        <ul class="works">
          {works.map((w) => (
            <li>
              <a href={`/works/${w.slug}/`} class="work">
                <div class="thumb">
                  {w.cover ? <img src={w.cover.src} srcset={w.cover.srcset} sizes="(max-width: 700px) 94vw, 24rem" alt="" loading="lazy" decoding="async" /> : <span class="display" aria-hidden="true">{w.title.slice(0, 1)}</span>}
                </div>
                <div class="about">
                  <p class="label">
                    {PROJECT_KINDS[w.kind]}
                    {w.latestVersion && <span> · {w.latestVersion}</span>}
                    {w.hidden && <span class="badge-draft">隐藏 · HIDDEN</span>}
                  </p>
                  <h2 class="cjk">{w.title}</h2>
                  {w.summary && <p class="summary">{w.summary}</p>}
                  <p class="meta">
                    <span>更新 {fmtDate(w.updatedAt)}</span>
                    {w.fileCount > 0 && <span>下载 {w.downloads.toLocaleString('zh-CN')}</span>}
                  </p>
                </div>
              </a>
            </li>
          ))}
        </ul>
      )
    }
  </div>
</Base>

<style>
  .none {
    padding: 2rem 0 6rem;
    border-top: 1.5px solid var(--rule-strong);
    color: var(--ink-3);
  }

  .works {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(19rem, 1fr));
    gap: 2rem 1.5rem;
    list-style: none;
    margin: 0;
    padding: 2rem 0 5rem;
    border-top: 1.5px solid var(--rule-strong);
  }

  .work {
    display: grid;
    gap: 0.9rem;
  }

  .thumb {
    display: grid;
    place-items: center;
    aspect-ratio: 16 / 9;
    border: 1px solid var(--rule);
    border-radius: var(--radius);
    background: var(--paper-2);
    overflow: hidden;
  }

  .thumb img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.5s var(--ease);
  }

  .work:hover .thumb img {
    transform: scale(1.03);
  }

  .thumb .display {
    font-size: 4rem;
    font-style: italic;
    color: var(--ink-3);
  }

  .about p {
    margin: 0;
  }

  .about h2 {
    margin: 0.3rem 0 0.4rem;
    font-size: 1.5rem;
    line-height: 1.25;
    transition: color 0.2s;
  }

  .work:hover h2 {
    color: var(--sky-ink);
  }

  .summary {
    color: var(--ink-2);
    font-size: 0.95rem;
    line-height: 1.6;
  }

  .meta {
    display: flex;
    gap: 1rem;
    margin-top: 0.6rem !important;
    font-family: var(--font-mono);
    font-size: 0.74rem;
    color: var(--ink-3);
  }
</style>
