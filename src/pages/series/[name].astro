---
import Base from '@/layouts/Base.astro';
import PostRecord from '@/components/PostRecord.astro';
import { fmtDate, getPosts, groupBy, postNumbers, postUrl, seriesName, slugify, sortSeries, viewerOf } from '@/lib/posts';

export const prerender = false;

const groups = groupBy(getPosts(viewerOf(Astro.locals)), (p) => p.data.series);
const found = [...groups].find(([name]) => slugify(name) === Astro.params.name);
if (!found) return new Response(null, { status: 404 });
const name = found[0];
const posts = sortSeries(found[1]);
const numbers = postNumbers();
const words = posts.reduce((n, p) => n + p.words, 0);
const minutes = posts.reduce((n, p) => n + p.minutes, 0);
const dates = posts.map((p) => p.data.date.valueOf());
const others = [...groups].filter(([other]) => other !== name).sort((a, b) => b[1].length - a[1].length);
---

<Base title={seriesName(name)} description={`合订本「${seriesName(name)}」，共 ${posts.length} 篇。`}>
  <div class="spread">
    <div class="sheet">
      <p class="crumb mono">
        <a href="/series/">全部合订本</a>
        <span>合订本</span>
      </p>
      <header class="sheet-head">
        <h1>{seriesName(name)}</h1>
        <p class="mono">共 {posts.length} 篇</p>
      </header>
      <ul class="facts mono">
        <li>{words.toLocaleString('zh-CN')} 字</li>
        <li>约 {minutes >= 90 ? `${Math.round(minutes / 6) / 10} 小时` : `${minutes} 分钟`}</li>
        <li>{fmtDate(new Date(Math.min(...dates)))} 至 {fmtDate(new Date(Math.max(...dates)))}</li>
      </ul>
      <ol class="records">
        {posts.map((p, i) => <PostRecord post={p} number={numbers.get(p.id)} lead={String(i + 1).padStart(2, '0')} />)}
      </ol>
      {
        posts[0] && (
          <p class="start">
            <a class="more mono" href={postUrl(posts[0])}>
              从第一篇读起
            </a>
          </p>
        )
      }
    </div>

    <aside class="margin" aria-label="其他合订本">
      <h2 class="margin-h mono">其他合订本</h2>
      {
        others.length === 0 ? (
          <p class="mono">没有别的了。</p>
        ) : (
          <ul class="ledger">
            {others.map(([other, list]) => (
              <li>
                <a href={`/series/${slugify(other)}/`}>{seriesName(other)}</a>
                <span class="mono">{list.length} 篇</span>
              </li>
            ))}
          </ul>
        )
      }
    </aside>
  </div>
</Base>

<style>
  .facts {
    margin-top: 1rem;
  }

  .records {
    margin-top: 1.5rem;
  }

  .start {
    margin: 1rem 0 0;
  }
</style>
