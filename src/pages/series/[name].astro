---
import Base from '@/layouts/Base.astro';
import Icon from '@/components/Icon.astro';
import { fmtDate, getPosts, groupBy, postUrl, seriesName, slugify, sortSeries, type Post } from '@/lib/posts';
import { readingStats } from '@/lib/stats';

export async function getStaticPaths() {
  const groups = groupBy(await getPosts(), (p) => p.data.series);
  return [...groups].map(([name, posts]) => ({ params: { name: slugify(name) }, props: { name, posts } }));
}

const { name } = Astro.props as { name: string; posts: Post[] };
const posts = sortSeries(Astro.props.posts);
const stats = await Promise.all(posts.map(readingStats));
const totalWords = stats.reduce((n, s) => n + s.words, 0);
const totalMinutes = stats.reduce((n, s) => n + s.minutes, 0);
---

<Base title={seriesName(name)} description={`合订本「${seriesName(name)}」，共 ${posts.length} 篇。`}>
  <div class="wrap">
    <header class="page-head">
      <p class="label kicker"><a href="/series/" class="back">← 全部合订本</a> · Volume</p>
      <h1>{seriesName(name)}<span class="en">{posts.length} chapters · {totalWords.toLocaleString('zh-CN')} 字 · ≈ {Math.round(totalMinutes / 6) / 10} h</span></h1>
    </header>

    <ol class="chapters">
      {
        posts.map((p, i) => (
          <li class:list={['ch rise', { draft: p.data.draft }]} style={`--i:${i}`}>
            <a href={postUrl(p)}>
              <span class="no display">{String(i + 1).padStart(2, '0')}</span>
              <span class="body">
                <span class="t cjk">
                  {p.data.title}
                  {p.data.draft && <span class="badge-draft">草稿</span>}
                </span>
                {p.data.summary && <span class="s">{p.data.summary}</span>}
              </span>
              <span class="meta label">
                {fmtDate(p.data.date)}
                <br />
                {stats[i].minutes} min
              </span>
              <Icon name="arrow" class="go" />
            </a>
          </li>
        ))
      }
    </ol>
  </div>
</Base>

<style>
  .back:hover {
    color: var(--sky);
  }

  .chapters {
    list-style: none;
    margin: 0;
    padding: 0;
    border-top: 1.5px solid var(--rule-strong);
    counter-reset: ch;
  }

  .ch a {
    display: grid;
    grid-template-columns: 5rem minmax(0, 1fr) auto 1.5rem;
    gap: 1.5rem;
    align-items: center;
    padding: 1.4rem 0;
    border-bottom: 1px solid var(--rule);
    transition: background 0.25s;
  }

  .ch a:hover {
    background: linear-gradient(90deg, var(--paper-2), transparent);
  }

  .no {
    font-size: 3rem;
    line-height: 1;
    font-style: italic;
    color: var(--ink-3);
    transition: color 0.2s;
  }

  .ch a:hover .no {
    color: var(--sky);
  }

  .body {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }

  .t {
    font-size: 1.4rem;
    line-height: 1.35;
  }

  .s {
    color: var(--ink-2);
    font-size: 0.92rem;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .meta {
    text-align: right;
    line-height: 1.6;
  }

  .go {
    color: var(--ink-3);
  }

  .ch a:hover .go {
    color: var(--sky);
  }

  .ch.draft .t {
    color: var(--ink-2);
  }

  @media (max-width: 640px) {
    .ch a {
      grid-template-columns: 3rem minmax(0, 1fr);
    }
    .no {
      font-size: 2rem;
    }
    .meta,
    .go {
      display: none;
    }
  }
</style>
