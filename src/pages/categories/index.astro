---
import Base from '@/layouts/Base.astro';
import PostRecord from '@/components/PostRecord.astro';
import { CATEGORIES } from '@/site.config';
import { categoryUrl, getPosts, groupBy, postNumbers, viewerOf } from '@/lib/posts';

export const prerender = false;

const posts = getPosts(viewerOf(Astro.locals));
const groups = groupBy(posts, (p) => p.data.category);
const numbers = postNumbers();
const sections = Object.entries(CATEGORIES).map(([key, c]) => {
  const list = groups.get(key) ?? [];
  return { ...c, list, words: list.reduce((n, p) => n + p.words, 0) };
});
---

<Base title="分类" description="按分类浏览文章。">
  <div class="spread">
    <div class="sheet">
      <header class="sheet-head">
        <h1>分类</h1>
        <p class="mono">共 {sections.length} 类</p>
      </header>

      {
        sections.map((c) => (
          <section>
            <h2 class="group-head">
              {c.list.length > 0 ? <a href={categoryUrl(c.slug)}>{c.name}</a> : <span>{c.name}</span>}
              <span class="mono">{c.list.length} 篇</span>
            </h2>
            <p class="about">{c.description}</p>
            {c.list.length === 0 ? (
              <p class="empty">这一类还没有文章。</p>
            ) : (
              <>
                <ol class="records">
                  {c.list.slice(0, 5).map((p) => (
                    <PostRecord post={p} number={numbers.get(p.id)} />
                  ))}
                </ol>
                {c.list.length > 5 && (
                  <a class="more mono" href={categoryUrl(c.slug)}>
                    全部 {c.list.length} 篇
                  </a>
                )}
              </>
            )}
          </section>
        ))
      }
    </div>

    <aside class="margin" aria-label="分类统计">
      <h2 class="margin-h mono">各类篇数</h2>
      <ul class="shares">
        {
          sections.map((c) => (
            <li>
              <span class="share-name">{c.name}</span>
              <span class="mono">{c.list.length} 篇 | {c.words.toLocaleString('zh-CN')} 字</span>
              <span class="bar" aria-hidden="true">
                <i style={`width:${posts.length ? ((c.list.length / posts.length) * 100).toFixed(1) : 0}%`} />
              </span>
            </li>
          ))
        }
      </ul>
    </aside>
  </div>
</Base>

<style>
  .group-head {
    margin-top: 3rem;
  }

  .about {
    margin: 0.75rem 0 0;
    color: var(--ink-2);
  }

  .about + .records {
    margin-top: 0.75rem;
  }

  .shares {
    max-width: 20rem;
    margin: 0;
    padding: 0;
    list-style: none;
    border-top: 1px solid var(--rule);
  }

  .shares li {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: 0.4rem 1rem;
    align-items: baseline;
    padding: 0.7rem 0 0.8rem;
    border-bottom: 1px solid var(--rule);
  }

  /* each category's share of all posts, ink over hatching */
  .bar {
    grid-column: 1 / -1;
    height: 0.5rem;
    background: var(--hatch);
  }

  .bar i {
    display: block;
    height: 100%;
    background: var(--ink);
  }
</style>
