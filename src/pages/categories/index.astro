---
import Base from '@/layouts/Base.astro';
import { CATEGORIES } from '@/site.config';
import { categoryUrl, fmtDate, getPosts, groupBy, postUrl } from '@/lib/posts';

const groups = groupBy(await getPosts(), (p) => p.data.category);
---

<Base title="分类" description="按分类浏览文章。">
  <div class="wrap">
    <header class="page-head">
      <p class="label kicker">Sections · {Object.keys(CATEGORIES).length}</p>
      <h1>分类<span class="en">Categories</span></h1>
    </header>

    {
      Object.entries(CATEGORIES).map(([key, c], i) => {
        const list = groups.get(key) ?? [];
        return (
          <section class="drawer">
            <a class="head" href={categoryUrl(c.slug)}>
              <span class="no display">0{i + 1}</span>
              <span class="name cjk">{c.name}</span>
              <span class="en display">{c.en}</span>
              <span class="count label">{list.length} entries →</span>
            </a>
            <ul>
              {list.slice(0, 5).map((p) => (
                <li>
                  <a href={postUrl(p)}>
                    <span class="label">{fmtDate(p.data.date)}</span>
                    <span class="cjk">{p.data.title}</span>
                  </a>
                </li>
              ))}
            </ul>
          </section>
        );
      })
    }
  </div>
</Base>

<style>
  .drawer {
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
    gap: 0.5rem 3rem;
    padding: 2rem 0 2.5rem;
    border-top: 1.5px solid var(--rule-strong);
  }

  .head {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.25rem 1rem;
  }

  .no {
    font-size: 3.5rem;
    line-height: 1;
    color: var(--sky);
  }

  .name {
    font-size: 2.6rem;
    line-height: 1;
  }

  .head:hover .name {
    color: var(--sky-ink);
  }

  .en {
    font-style: italic;
    font-size: 1.3rem;
    color: var(--ink-3);
  }

  .count {
    flex-basis: 100%;
  }

  .desc {
    grid-column: 1;
    margin: 0;
    color: var(--ink-2);
  }

  ul {
    grid-column: 2;
    grid-row: 1 / span 2;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  li a {
    display: flex;
    gap: 1.25rem;
    align-items: baseline;
    padding: 0.6rem 0;
    border-bottom: 1px solid var(--rule);
  }

  li a .cjk {
    font-size: 1.05rem;
  }

  li a:hover .cjk {
    color: var(--sky-ink);
  }

  @media (max-width: 760px) {
    .drawer {
      grid-template-columns: 1fr;
    }
    ul,
    .desc {
      grid-column: 1;
      grid-row: auto;
    }
  }
</style>
