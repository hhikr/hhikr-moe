---
import { Image } from 'astro:assets';
import Base from '@/layouts/Base.astro';
import PostRow from '@/components/PostRow.astro';
import SeriesCard from '@/components/SeriesCard.astro';
import Icon from '@/components/Icon.astro';
import { AUTHOR, CATEGORIES, SITE, SOCIALS } from '@/site.config';
import { categoryUrl, fmtDate, getPosts, groupBy, postUrl } from '@/lib/posts';
import { readingStats } from '@/lib/stats';
import sky from '@/assets/sky.jpg';
import avatar from '@/assets/avatar.png';

const posts = await getPosts();
const latest = posts.filter((p) => !p.data.draft).slice(0, 6);
const series = [...groupBy(posts, (p) => p.data.series)].sort((a, b) => b[1].length - a[1].length);
const byCategory = groupBy(posts, (p) => p.data.category);
const tagCount = new Set(posts.flatMap((p) => p.data.tags)).size;
const words = (await Promise.all(posts.map(readingStats))).reduce((n, s) => n + s.words, 0);
const startHere = posts.find((p) => p.id === 'time-machine');

const stats = [
  { n: posts.length, label: '篇文章', en: 'entries' },
  { n: series.length, label: '个合订本', en: 'volumes' },
  words >= 10000
    ? { n: (words / 10000).toFixed(1), label: '万字', en: 'words' }
    : { n: words, label: '字', en: 'words' },
  { n: tagCount, label: '个标签', en: 'tags' },
];
---

<Base>
  <section class="hero wrap">
    <div class="hero-text">
      <p class="label kicker rise">{posts.length} 篇文章 · {SITE.since} 年起</p>
      <h1 class="masthead display rise" style="--i:1">
        Hitch&shy;hiker<span class="star" aria-hidden="true">✦</span>
      </h1>
      <p class="sub cjk rise" style="--i:2">{AUTHOR.name} 的个人网站</p>
      <p class="intro rise" style="--i:3">
        {AUTHOR.bio}。
      </p>
      <div class="actions rise" style="--i:4">
        {
          startHere && (
            <a class="btn primary" href={postUrl(startHere)}>
              <span class="cjk">引导之始</span>
              <Icon name="arrow" size={16} />
            </a>
          )
        }
        <a class="btn" href="/posts/"><span class="cjk">浏览全部文章</span></a>
        <ul class="socials" aria-label="社交链接">
          {
            SOCIALS.map((s) => (
              <li>
                <a href={s.href} target="_blank" rel="noopener noreferrer me" aria-label={s.label} title={s.label}>
                  <Icon name={s.icon} size={18} />
                </a>
              </li>
            ))
          }
        </ul>
      </div>
    </div>

    <figure class="postcard rise" style="--i:2">
      <div class="stamp">
        <Image src={sky} alt="蓝天白云下抬头望天的女孩插画" widths={[480, 760, 1100]} sizes="(max-width: 860px) 92vw, 34rem" loading="eager" class="sky" />
        <span class="postmark label" aria-hidden="true">HHIKR.MOE<br />{fmtDate(new Date())}</span>
      </div>
      <div class="polaroid">
        <Image src={avatar} alt={`${AUTHOR.name} 的头像（铅笔线稿）`} width={220} class="avatar" />
        <span class="cjk">hhikr</span>
      </div>
    </figure>

    <div class="horizon" aria-hidden="true"><span class="walker"></span></div>
  </section>

  <section class="wrap stats" aria-label="站点统计">
    {
      stats.map((s, i) => (
        <div class="stat rise" style={`--i:${i + 3}`}>
          <span class="n display">{s.n}</span>
          <span class="l">
            <span class="cjk">{s.label}</span>
            <span class="label">{s.en}</span>
          </span>
        </div>
      ))
    }
  </section>

  <section class="wrap block">
    <header class="section-head">
      <span class="label">§ 01</span>
      <h2>最新</h2>
      <span class="en">Latest</span>
      <a class="more link-arrow" href="/posts/">全部文章 →</a>
    </header>
    <ol class="rows">
      {latest.map((p, i) => <PostRow post={p} index={i} />)}
    </ol>
  </section>

  {
    series.length > 0 && (
      <section class="wrap block">
        <header class="section-head">
          <span class="label">§ 02</span>
          <h2>合订本</h2>
          <span class="en">Series</span>
          <a class="more link-arrow" href="/series/">全部合订本 →</a>
        </header>
        <div class="series-grid">
          {series.map(([name, ps], i) => (
            <SeriesCard name={name} posts={ps} index={i} />
          ))}
        </div>
      </section>
    )
  }

  <section class="wrap block">
    <header class="section-head">
      <span class="label">§ 03</span>
      <h2>分类</h2>
      <span class="en">Sections</span>
      <a class="more link-arrow" href="/categories/">全部分类 →</a>
    </header>
    <div class="cats">
      {
        Object.entries(CATEGORIES).map(([key, c], i) => {
          const list = byCategory.get(key) ?? [];
          return (
            <a href={categoryUrl(c.slug)} class="cat rise" style={`--i:${i}`}>
              <span class="cat-n display">{String(list.length).padStart(2, '0')}</span>
              <span class="cat-name cjk">{c.name}</span>
              <span class="cat-en display">{c.en}</span>
              <span class="cat-latest label">{list[0] ? `最近：${list[0].data.title}` : '暂无文章'}</span>
            </a>
          );
        })
      }
    </div>
  </section>
</Base>

<style>
  .hero {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
    gap: clamp(2rem, 5vw, 5rem);
    align-items: center;
    padding-top: clamp(2.5rem, 7vw, 6rem);
    padding-bottom: clamp(4rem, 8vw, 7rem);
  }

  .kicker {
    margin: 0 0 1.5rem;
  }

  .masthead {
    position: relative;
    margin: 0;
    font-size: clamp(4.2rem, 13.5vw, 11.5rem);
    line-height: 0.82;
    letter-spacing: -0.045em;
    font-style: italic;
    hyphens: manual;
  }

  .star {
    display: inline-block;
    font-style: normal;
    font-size: 0.28em;
    vertical-align: 1.9em;
    margin-left: 0.08em;
    color: var(--sky);
    animation: twinkle 4s ease-in-out infinite;
  }

  @keyframes twinkle {
    50% {
      opacity: 0.35;
      transform: rotate(45deg) scale(0.85);
    }
  }

  .sub {
    margin: 1.4rem 0 0;
    font-size: clamp(1.4rem, 2.6vw, 2rem);
    line-height: 1.3;
  }

  .intro {
    max-width: 32rem;
    margin: 1rem 0 0;
    font-size: 1.05rem;
    color: var(--ink-2);
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem;
    margin-top: 2rem;
  }

  .btn {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    height: 2.75rem;
    padding: 0 1.25rem;
    border: 1.5px solid var(--ink);
    border-radius: 999px;
    font-size: 1.02rem;
    transition: background 0.25s, color 0.25s, transform 0.25s var(--ease), box-shadow 0.25s;
  }

  .btn:hover {
    transform: translate(-2px, -2px);
    box-shadow: 3px 3px 0 var(--ink);
  }

  .btn.primary {
    background: var(--ink);
    color: var(--paper);
  }

  .btn.primary:hover {
    background: var(--sky);
    border-color: var(--sky);
    box-shadow: 3px 3px 0 var(--ink);
  }

  .socials {
    display: flex;
    gap: 0.15rem;
    list-style: none;
    margin: 0 0 0 0.5rem;
    padding: 0;
  }

  .socials a {
    display: grid;
    place-items: center;
    width: 2.5rem;
    height: 2.5rem;
    border-radius: 999px;
    color: var(--ink-2);
    transition: color 0.2s, background 0.2s;
  }

  .socials a:hover {
    color: var(--sky);
    background: var(--paper-2);
  }

  /* postcard */
  .postcard {
    position: relative;
    margin: 0;
    justify-self: end;
    width: 100%;
    max-width: 34rem;
  }

  .stamp {
    position: relative;
    padding: 10px;
    background: var(--card);
    /* perforated stamp edge */
    -webkit-mask:
      radial-gradient(circle 5px at 5px 5px, #0000 98%, #000) -5px -5px / 15px 15px,
      linear-gradient(#000 0 0) 10px 10px / calc(100% - 20px) calc(100% - 20px) no-repeat;
    -webkit-mask-composite: source-over;
    mask:
      radial-gradient(circle 5px at 5px 5px, #0000 98%, #000) -5px -5px / 15px 15px,
      linear-gradient(#000 0 0) 10px 10px / calc(100% - 20px) calc(100% - 20px) no-repeat;
    filter: drop-shadow(0 12px 22px rgb(28 26 22 / 0.18));
    transform: rotate(1.5deg);
  }

  .sky {
    display: block;
    width: 100%;
    aspect-ratio: 4 / 3;
    object-fit: cover;
    object-position: 30% 60%;
  }

  .postmark {
    position: absolute;
    top: 1.6rem;
    right: 1.6rem;
    padding: 0.5rem 0.7rem;
    border: 1.5px solid rgb(255 255 255 / 0.85);
    border-radius: 999px;
    color: #fff;
    text-align: center;
    line-height: 1.4;
    font-size: 0.62rem;
    transform: rotate(-12deg);
    text-shadow: 0 1px 2px rgb(0 0 0 / 0.2);
  }


  .polaroid {
    position: absolute;
    left: -2.5rem;
    bottom: -2.25rem;
    width: 9.5rem;
    padding: 0.5rem 0.5rem 0.4rem;
    background: #fbf8ef;
    box-shadow: var(--shadow);
    transform: rotate(-6deg);
    text-align: center;
    transition: transform 0.5s var(--ease);
  }

  .polaroid:hover {
    transform: rotate(-2deg) translateY(-6px) scale(1.04);
  }

  .polaroid::before {
    /* tape */
    content: '';
    position: absolute;
    top: -0.7rem;
    left: 50%;
    width: 4.5rem;
    height: 1.4rem;
    transform: translateX(-50%) rotate(3deg);
    background: color-mix(in srgb, var(--sky) 30%, rgb(255 255 255 / 0.55));
    backdrop-filter: blur(1px);
  }

  .avatar {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 1;
    object-fit: cover;
    object-position: top;
  }

  .polaroid span {
    display: block;
    margin-top: 0.25rem;
    font-size: 0.95rem;
    color: #3a372f;
  }

  .horizon {
    position: absolute;
    left: var(--gutter);
    right: var(--gutter);
    bottom: 0;
    height: 1.5px;
    background: var(--rule-strong);
  }

  .walker {
    position: absolute;
    right: 6%;
    bottom: 1px;
    width: 64px;
    height: 60px;
    background: var(--ink);
    -webkit-mask: url('/mark.png') bottom / contain no-repeat;
    mask: url('/mark.png') bottom / contain no-repeat;
  }

  /* stats */
  .stats {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    border-bottom: 1px solid var(--rule);
  }

  .stat {
    display: flex;
    align-items: baseline;
    gap: 0.75rem;
    padding: 1.5rem 1rem 1.5rem 0;
  }

  .stat + .stat {
    padding-left: 1.5rem;
    border-left: 1px solid var(--rule);
  }

  .stat .n {
    font-size: clamp(2.4rem, 4.5vw, 3.6rem);
    line-height: 1;
  }

  .stat .l {
    display: flex;
    flex-direction: column;
    line-height: 1.3;
  }

  .stat .l .cjk {
    font-size: 1rem;
  }

  .block {
    margin-top: clamp(3.5rem, 7vw, 6rem);
  }

  .rows {
    margin: 0;
    padding: 0;
    border-top: 1px solid var(--rule);
  }

  .series-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(17rem, 1fr));
    gap: 1.25rem;
  }

  .cats {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    border-top: 1px solid var(--rule);
  }

  .cat {
    display: grid;
    grid-template-columns: auto 1fr;
    grid-template-areas:
      'n name'
      'n en'
      'latest latest';
    column-gap: 1rem;
    padding: 1.75rem 1.5rem 1.75rem 0;
    border-bottom: 1px solid var(--rule);
    transition: background 0.3s;
  }

  .cat + .cat {
    padding-left: 1.5rem;
    border-left: 1px solid var(--rule);
  }

  .cat:hover {
    background: var(--paper-2);
  }

  .cat-n {
    grid-area: n;
    font-size: 4rem;
    line-height: 0.85;
    color: var(--sky);
  }

  .cat-name {
    grid-area: name;
    font-size: 1.7rem;
    line-height: 1.1;
  }

  .cat-en {
    grid-area: en;
    font-style: italic;
    color: var(--ink-3);
    font-size: 1.1rem;
  }


  .cat-latest {
    grid-area: latest;
    margin-top: 0.75rem;
    text-transform: none;
    letter-spacing: 0.02em;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  @media (max-width: 860px) {
    .hero {
      grid-template-columns: 1fr;
      padding-bottom: 5rem;
    }
    .postcard {
      justify-self: center;
      max-width: 30rem;
      margin-top: 1rem;
    }
    .polaroid {
      left: auto;
      right: -0.5rem;
      bottom: -2.5rem;
      width: 7.5rem;
    }
    .walker {
      right: auto;
      left: 4%;
      width: 48px;
      height: 45px;
    }
    .stats {
      grid-template-columns: 1fr 1fr;
    }
    .stat:nth-child(3) {
      padding-left: 0;
      border-left: 0;
    }
    .stat:nth-child(n + 3) {
      border-top: 1px solid var(--rule);
    }
    .cats {
      grid-template-columns: 1fr;
    }
    .cat + .cat {
      padding-left: 0;
      border-left: 0;
    }
  }
</style>
