---
import Base from '@/layouts/Base.astro';
import { AUTHOR, CATEGORIES, SITE, SOCIALS } from '@/site.config';
import { categoryOf, categoryUrl, fmtDate, getPosts, groupBy, postNumbers, postUrl, seriesName, seriesUrl, viewerOf } from '@/lib/posts';
import { listProjects, PROJECT_KINDS } from '@/server/projects.ts';

export const prerender = false;

const viewer = viewerOf(Astro.locals);
const posts = getPosts(viewer);
const numbers = postNumbers();
const latest = posts[0];
const latestCat = latest && categoryOf(latest);
const n = (x: number) => x.toLocaleString('zh-CN');

const words = posts.reduce((sum, p) => sum + p.words, 0);
const first = posts.length ? new Date(Math.min(...posts.map((p) => p.data.date.valueOf()))) : undefined;
const days = first ? Math.floor((Date.now() - first.valueOf()) / 86_400_000) + 1 : 0;

const byCategory = groupBy(posts, (p) => p.data.category);
const categories = Object.entries(CATEGORIES).map(([key, c]) => {
  const list = byCategory.get(key) ?? [];
  return { ...c, count: list.length, share: posts.length ? list.length / posts.length : 0 };
});
const series = [...groupBy(posts, (p) => p.data.series)]
  .map(([name, list]) => ({ name, count: list.length, words: list.reduce((sum, p) => sum + p.words, 0) }))
  .sort((a, b) => b.count - a.count);
const works = listProjects(viewer);
// One page per problem, named by its number on LeetCode.
const problems = Object.keys(import.meta.glob('./hot100/*.astro'))
  .map((f) => Number(f.match(/\/(\d+)\.astro$/)?.[1]))
  .filter(Boolean)
  .sort((a, b) => a - b);

// The parts of the site. Pointing at one in the index shows what is in it.
const parts = [
  { k: 'posts', name: '文章', en: 'Posts', count: posts.length, href: '/posts/', all: `全部 ${posts.length} 篇` },
  { k: 'series', name: '合订本', en: 'Series', count: series.length, href: '/series/', all: `全部 ${series.length} 本` },
  { k: 'hot', name: '题单', en: 'Hot 100', count: problems.length, href: '/hot100/', all: '进入题单' },
  { k: 'cats', name: '分类', en: 'Categories', count: categories.length, href: '/categories/', all: '全部分类' },
  { k: 'works', name: '作品', en: 'Works', count: works.length, href: '/works/', all: `全部 ${works.length} 件` },
  { k: 'about', name: '关于', en: 'About', count: SITE.since, href: '/about/', all: '关于这个站' },
];
const ticker = posts.slice(0, 10);
---

<Base>
  <div class="home">
    <section class="hero" data-hero>
      <p class="hero-meta">
        <time datetime={new Date().toISOString()}>{fmtDate(new Date())}</time>
        {first && <span>第 <b data-fx-load>{n(days)}</b> 天</span>}
        <span><b data-fx-load>{posts.length}</b> 篇</span>
        <span><b data-fx-load>{n(words)}</b> 字</span>
      </p>

      <h1 class="wordmark">
        <span class="solid">HHIKR</span>
        <span class="hollow" aria-hidden="true">.MOE</span>
      </h1>

      <div class="hero-copy">
        <p class="claim"><span>{AUTHOR.name} 的个人网站</span></p>
        <p class="bio">{AUTHOR.bio}。学习笔记、折腾记录与杂谈。</p>
        <p class="actions">
          {
            latest && (
              <a class="btn go" href={postUrl(latest)}>
                读最新一篇 <span class="no">{numbers.get(latest.id)}</span>
              </a>
            )
          }
          <a class="btn" href="/posts/">全部文章</a>
          <a class="btn" href="/hot100/">题单 Hot 100</a>
        </p>
      </div>

      <figure class="hero-art">
        <div class="frame">
          <img
            src="/img/avatar-869.webp"
            srcset="/img/avatar-560.webp 560w, /img/avatar-869.webp 869w"
            sizes="(max-width: 899px) 100vw, 42vw"
            width="869"
            height="979"
            alt={`${AUTHOR.name} 的头像：闭着眼大笑的短发女孩，铅笔线稿`}
            loading="eager"
            decoding="sync"
            fetchpriority="high"
          />
        </div>
        <figcaption>{AUTHOR.headline}</figcaption>
      </figure>

      {
        ticker.length > 0 && (
          <div class="ticker" aria-label="最近的文章">
            <div class="track">
              {[0, 1].map((copy) => (
                <ul aria-hidden={copy === 1 ? 'true' : undefined}>
                  {ticker.map((p) => (
                    <li>
                      <a href={postUrl(p)} tabindex={copy === 1 ? -1 : undefined}>
                        <b>{numbers.get(p.id)}</b>
                        {p.data.title}
                      </a>
                    </li>
                  ))}
                </ul>
              ))}
            </div>
          </div>
        )
      }
    </section>

    {
      latest && (
        <section class="latest" aria-labelledby="latest-h">
          <a href={postUrl(latest)} data-fx-host>
            <span class="big-no" aria-hidden="true" data-fx>
              {numbers.get(latest.id)?.replace('No.', '')}
            </span>
            <span class="latest-body">
              <span class="latest-meta">
                <span class="flag">最新</span>
                <time datetime={latest.data.date.toISOString()}>{fmtDate(latest.data.date)}</time>
                <span>{n(latest.words)} 字</span>
                <span>约 {latest.minutes} 分钟</span>
                {latestCat && <span>{latestCat.name}</span>}
              </span>
              <span id="latest-h" class="latest-title">{latest.data.title}</span>
              {latest.data.summary && <span class="latest-summary">{latest.data.summary}</span>}
              <span class="btn go">阅读全文</span>
            </span>
          </a>
        </section>
      )
    }

    <section class="index" aria-labelledby="index-h">
      <h2 id="index-h" class="bar-title">全站索引</h2>
      <div class="index-grid" data-index>
        {
          parts.map((part, i) => (
            <>
              <a class:list={['row', { 'is-active': i === 0 }]} data-row={part.k} href={part.href} style={`grid-row:${i + 1}`} data-fx-host>
                <span class="row-name">{part.name}</span>
                <span class="row-en">{part.en}</span>
                <span class="row-count" data-fx>{part.count}</span>
              </a>
              <div class:list={['pane', { 'is-active': i === 0 }]} data-pane={part.k}>
                {part.k === 'posts' &&
                  (posts.length > 0 ? (
                    <ol class="records">
                      {posts.slice(0, 7).map((p) => (
                        <li>
                          <a class="record" href={postUrl(p)}>
                            <span class="tag">{numbers.get(p.id)}</span>
                            <time class="mono" datetime={p.data.date.toISOString()}>{fmtDate(p.data.date)}</time>
                            <span class="name">
                              {p.data.title}
                              {p.data.hidden && <span class="badge-draft">隐藏</span>}
                            </span>
                            <span class="mono">{n(p.words)} 字</span>
                          </a>
                        </li>
                      ))}
                    </ol>
                  ) : (
                    <p class="none">还没有发布文章。</p>
                  ))}

                {part.k === 'series' &&
                  (series.length > 0 ? (
                    <ul class="lines">
                      {series.slice(0, 7).map((s) => (
                        <li>
                          <a href={seriesUrl(s.name)}>
                            <span>{seriesName(s.name)}</span>
                            <span class="mono">
                              {s.count} 篇，{n(s.words)} 字
                            </span>
                          </a>
                        </li>
                      ))}
                    </ul>
                  ) : (
                    <p class="none">还没有合订本。</p>
                  ))}

                {part.k === 'hot' && (
                  <>
                    <p class="pane-lead">每一格是一道题，数字是它在力扣上的题号。每道题都有 Java 解法、逐步演示和编程练习。</p>
                    <ol class="matrix">
                      {problems.map((id, at) => (
                        <li style={`--i:${at}`}>
                          <a href={`/hot100/${id}/`}>{id}</a>
                        </li>
                      ))}
                    </ol>
                  </>
                )}

                {part.k === 'cats' && (
                  <ul class="cats">
                    {categories.map((c) => (
                      <li>
                        <a href={categoryUrl(c.slug)}>
                          <span class="cat-name">{c.name}</span>
                          <span class="mono">{c.count} 篇</span>
                          <span class="bar" aria-hidden="true">
                            <i style={`width:${(c.share * 100).toFixed(1)}%`} />
                          </span>
                          <span class="cat-about">{c.description}</span>
                        </a>
                      </li>
                    ))}
                  </ul>
                )}

                {part.k === 'works' &&
                  (works.length > 0 ? (
                    <ul class="lines">
                      {works.slice(0, 6).map((w) => (
                        <li>
                          <a href={`/works/${w.slug}/`}>
                            <span>{w.title}</span>
                            <span class="mono">
                              {PROJECT_KINDS[w.kind]}
                              {w.latestVersion && `，${w.latestVersion}`}，更新 {fmtDate(w.updatedAt)}
                            </span>
                          </a>
                        </li>
                      ))}
                    </ul>
                  ) : (
                    <p class="none">还没有发布作品。做好的 mod 和小工具会放在这里，可以直接下载。</p>
                  ))}

                {part.k === 'about' && (
                  <div class="who">
                    <img src="/img/sky-480.webp" width="480" height="270" alt="蓝天白云下抬头望天的女孩插画" loading="lazy" decoding="async" />
                    <div>
                      <p class="who-name">{AUTHOR.name}</p>
                      <p class="who-bio">{AUTHOR.bio}。</p>
                      <p class="actions">
                        {SOCIALS.map((s) => (
                          <a class="btn" href={s.href} target="_blank" rel="noopener noreferrer me">
                            {s.label}
                          </a>
                        ))}
                      </p>
                    </div>
                  </div>
                )}

                <p class="pane-foot">
                  <a class="btn go" href={part.href}>
                    {part.all}
                  </a>
                </p>
              </div>
            </>
          ))
        }
      </div>
    </section>
  </div>
</Base>

<script>
  import { wireReadouts } from '@/scripts/fx';

  wireReadouts();

  // The index: pointing at a row (or reaching it with the keyboard) shows
  // what is in that part of the site, and it stays shown until another is picked.
  const index = document.querySelector<HTMLElement>('[data-index]');
  if (index) {
    const pick = (key: string) => {
      index.querySelectorAll<HTMLElement>('[data-row]').forEach((row) => row.classList.toggle('is-active', row.dataset.row === key));
      index.querySelectorAll<HTMLElement>('[data-pane]').forEach((pane) => pane.classList.toggle('is-active', pane.dataset.pane === key));
    };
    index.querySelectorAll<HTMLElement>('[data-row]').forEach((row) => {
      row.addEventListener('pointerenter', (e) => e.pointerType === 'mouse' && pick(row.dataset.row!));
      row.addEventListener('focus', () => pick(row.dataset.row!));
    });
  }

  // The picture leans a little away from the pointer.
  const hero = document.querySelector<HTMLElement>('[data-hero]');
  if (hero && matchMedia('(prefers-reduced-motion: no-preference) and (hover: hover)').matches) {
    hero.addEventListener('pointermove', (e) => {
      const box = hero.getBoundingClientRect();
      hero.style.setProperty('--mx', ((e.clientX - box.left) / box.width - 0.5).toFixed(3));
      hero.style.setProperty('--my', ((e.clientY - box.top) / box.height - 0.5).toFixed(3));
    });
  }
</script>

<style>
  .home {
    width: 100%;
    font-family: var(--font-ui);
  }

  /* The newest post is one big link: pointing anywhere on it works its button. */
  a:hover > .latest-body > .btn {
    color: var(--on-signal);
  }

  a:hover > .latest-body > .btn::before {
    transform: none;
  }

  a:hover > .latest-body > .btn::after {
    animation: edge 0.3s var(--mech);
  }

  /* ---------- the opening ---------- */
  .hero {
    --mx: 0;
    --my: 0;
    container-type: inline-size;
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 42%);
    grid-template-rows: auto 1fr auto auto;
    column-gap: clamp(1.5rem, 4vw, 3.5rem);
    min-height: min(46rem, calc(100dvh - 3px));
    padding-top: 1.25rem;
    border-bottom: 1px solid var(--rule);
    overflow: hidden;
  }

  .hero-meta {
    grid-column: 1;
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 0;
    margin: 0;
    padding-inline: var(--pad);
    font-size: var(--t-mono);
    color: var(--ink-2);
  }

  .hero-meta > * + *::before {
    content: '/';
    margin-inline: 0.75em;
    color: var(--rule);
  }

  /* The name: as heavy and as wide as the column takes. */
  .wordmark {
    grid-column: 1;
    align-self: end;
    display: flex;
    flex-direction: column;
    margin: 2rem 0 0;
    padding-left: var(--pad);
    font-weight: 800;
    line-height: 0.84;
    letter-spacing: -0.065em;
  }

  .wordmark .solid {
    font-size: clamp(4.25rem, 16.5cqi, 13.5rem);
  }

  .wordmark .hollow {
    margin-top: 0.12em;
    font-size: clamp(2.4rem, 8cqi, 6.5rem);
    color: transparent;
    -webkit-text-stroke: 2px var(--ink);
  }

  .hero-copy {
    grid-column: 1;
    padding: 1.75rem var(--pad) 2.25rem;
  }

  .hero-copy p {
    margin: 0;
  }

  /* a marker stroke under the one line that says what this is */
  .claim span {
    padding: 0.1em 0.45em;
    background: linear-gradient(var(--signal), var(--signal)) left / 100% 100% no-repeat;
    color: var(--on-signal);
    font-size: clamp(1.15rem, 2.1cqi, 1.6rem);
    font-weight: 800;
    -webkit-box-decoration-break: clone;
    box-decoration-break: clone;
  }

  .bio {
    max-width: 30rem;
    margin-top: 0.9rem !important;
    color: var(--ink-2);
  }

  .hero-copy .actions {
    margin-top: 1.5rem;
  }

  /* the picture: a cut frame, a hatched shadow, a plate with the motto */
  .hero-art {
    grid-column: 2;
    grid-row: 1 / 4;
    position: relative;
    margin: 0 var(--pad) 2.25rem 0;
    min-height: 20rem;
  }

  .hero-art::before {
    content: '';
    position: absolute;
    inset: 1.5rem -1rem -1rem 1.5rem;
    background: var(--hatch);
    transform: translate(calc(var(--mx) * 12px), calc(var(--my) * 10px));
  }

  .frame {
    position: absolute;
    inset: 0;
    clip-path: polygon(3.25rem 0, 100% 0, 100% calc(100% - 3.25rem), calc(100% - 3.25rem) 100%, 0 100%, 0 3.25rem);
    /* the colour of the paper the drawing is on, so the frame reads as one sheet */
    background: #fffff3;
  }

  /* The drawing stands on the bottom edge with room over its head, rather than
     filling the frame with a face. Its sides fade into the sheet, where the
     lines of the hood would otherwise stop dead at the edge of the scan. */
  .frame img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: contain;
    object-position: 50% 100%;
    transform-origin: 50% 100%;
    transform: scale(0.92) translate(calc(var(--mx) * -14px), calc(var(--my) * -8px));
    transition: transform 0.4s var(--ease);
    -webkit-mask: linear-gradient(90deg, transparent, #000 7%, #000 93%, transparent);
    mask: linear-gradient(90deg, transparent, #000 7%, #000 93%, transparent);
  }

  .hero-art figcaption {
    position: absolute;
    left: -1.25rem;
    bottom: 1.75rem;
    max-width: 78%;
    padding: 0.55rem 1.4rem 0.6rem 0.9rem;
    background: linear-gradient(-45deg, transparent 0.6rem, var(--ink) calc(0.6rem + 0.5px));
    color: var(--panel);
    font-size: clamp(0.85rem, 1.45cqi, 1.1rem);
    font-weight: 600;
    line-height: 1.45;
  }

  /* Opening the page, in order: the name is driven in from the left behind a
     shutter, the yellow stroke is laid down under the claim, the picture is
     uncovered from its cut corner with a scan line running down it, and the
     figures in the top line settle (fx.ts). Under a second, then it is still. */
  .frame::after {
    content: '';
    position: absolute;
    inset: 0 0 auto 0;
    height: 3px;
    background: var(--signal);
    opacity: 0;
    pointer-events: none;
  }

  @media (prefers-reduced-motion: no-preference) {
    .wordmark .solid,
    .wordmark .hollow {
      animation: drive 620ms var(--mech) both;
    }
    .wordmark .hollow {
      animation-delay: 140ms;
    }
    @keyframes drive {
      from {
        clip-path: inset(0 100% 0 0);
        transform: translateX(-0.12em);
      }
      to {
        clip-path: inset(0 -5% 0 0);
        transform: none;
      }
    }

    .claim span {
      animation: stroke 420ms var(--mech) 420ms both;
    }
    @keyframes stroke {
      from {
        background-size: 0% 100%;
      }
    }

    .frame {
      animation: uncover 760ms var(--mech) 120ms both;
    }
    @keyframes uncover {
      from {
        clip-path: polygon(3.25rem 0, 3.25rem 0, 3.25rem 0, 0 3.25rem, 0 3.25rem, 0 3.25rem);
      }
    }

    .frame::after {
      animation: scan 900ms linear 500ms both;
    }
    @keyframes scan {
      0% {
        top: 0;
        opacity: 0.9;
      }
      90% {
        opacity: 0.9;
      }
      100% {
        top: 100%;
        opacity: 0;
      }
    }

    .hero-art figcaption {
      animation: plate 420ms var(--snap) 780ms both;
    }
    @keyframes plate {
      from {
        opacity: 0;
        transform: translateX(-1.25rem);
      }
    }
  }
  /* the recent posts, passing by */
  .ticker {
    grid-column: 1 / -1;
    background: var(--ink);
    color: var(--panel);
    overflow: hidden;
  }

  .track {
    display: flex;
    width: max-content;
  }

  .ticker ul {
    display: flex;
    flex: none;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .ticker a {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 0.6rem 1.5rem;
    font-size: 0.875rem;
    white-space: nowrap;
  }

  .ticker b {
    padding: 0 0.45em;
    background: var(--signal);
    color: var(--on-signal);
    font-weight: 700;
  }

  .ticker a:hover {
    background: var(--signal);
    color: var(--on-signal);
  }

  .ticker a:hover b {
    background: var(--on-signal);
    color: var(--signal);
  }

  @media (prefers-reduced-motion: no-preference) {
    .track {
      animation: pass 60s linear infinite;
    }
    .ticker:hover .track,
    .ticker:focus-within .track {
      animation-play-state: paused;
    }
    @keyframes pass {
      to {
        transform: translateX(-50%);
      }
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .ticker {
      overflow-x: auto;
    }
    .ticker ul[aria-hidden] {
      display: none;
    }
  }

  /* ---------- the newest post ---------- */
  .latest {
    container-type: inline-size;
    background: var(--panel);
    border-bottom: 1px solid var(--rule);
  }

  .latest > a {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    align-items: center;
    gap: clamp(1.5rem, 5cqi, 4rem);
    padding: clamp(1.75rem, 4cqi, 3rem) var(--pad);
  }

  /* its number, hollow until pointed at */
  .big-no {
    font-size: clamp(5rem, 19cqi, 14rem);
    font-weight: 800;
    line-height: 0.8;
    letter-spacing: -0.06em;
    color: transparent;
    -webkit-text-stroke: 2px var(--ink);
    /* filled from the left, by ink poured into the outline */
    background: linear-gradient(var(--ink), var(--ink)) left / 0% 100% no-repeat;
    -webkit-background-clip: text;
    background-clip: text;
    transition: background-size 0.45s var(--mech);
  }

  .latest > a:hover .big-no,
  .latest > a:focus-visible .big-no {
    background-size: 100% 100%;
  }

  .latest-body {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.9rem;
    max-width: 44rem;
  }

  .latest-meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.3rem 1rem;
    font-size: var(--t-mono);
    color: var(--ink-2);
  }

  .flag {
    padding: 0.05em 0.6em;
    background: var(--signal);
    color: var(--on-signal);
    font-weight: 700;
  }

  .latest-title {
    font-size: clamp(1.6rem, 3.6cqi, 2.6rem);
    font-weight: 800;
    line-height: 1.2;
    letter-spacing: -0.01em;
    text-wrap: balance;
  }

  .latest-summary {
    font-family: var(--font-text);
    font-size: var(--t-body);
    line-height: 1.8;
    color: var(--ink-2);
  }

  /* ---------- the index: point at a part, see what is in it ---------- */
  .index {
    padding: clamp(2rem, 4vw, 3rem) var(--pad) 4rem;
  }

  .bar-title {
    display: flex;
    align-items: center;
    gap: 1.25rem;
    margin: 0 0 1.25rem;
    font-size: 1.15rem;
    font-weight: 800;
  }

  .bar-title::after {
    content: '';
    flex: 1;
    height: 0.8rem;
    background: var(--hatch);
    border-left: 0.8rem solid var(--ink);
  }

  .index-grid {
    display: grid;
    grid-template-columns: minmax(17rem, 36%) minmax(0, 1fr);
    grid-template-rows: repeat(6, auto) 1fr;
    column-gap: clamp(1.5rem, 3vw, 2.5rem);
    border-top: 2px solid var(--ink);
  }

  .row {
    grid-column: 1;
    position: relative;
    display: grid;
    grid-template-columns: auto minmax(0, 1fr) auto;
    align-items: baseline;
    gap: 0.9rem;
    padding: 0.85rem 1.1rem 0.85rem 1.4rem;
    border-bottom: 1px solid var(--rule);
    isolation: isolate;
    transition:
      color 0.12s 0.05s,
      padding 0.25s var(--snap);
  }

  /* Picking a row: an ink shutter is driven across it from the left, and
     leaves to the right when another is picked; the yellow bar follows it in. */
  .row::after {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    background: var(--ink);
