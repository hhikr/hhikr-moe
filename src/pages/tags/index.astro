---
import Base from '@/layouts/Base.astro';
import { getPosts, groupBy, tagUrl, viewerOf } from '@/lib/posts';

export const prerender = false;

const posts = getPosts(viewerOf(Astro.locals));
const tags = [...groupBy(posts, (p) => p.data.tags)].sort((a, b) => b[1].length - a[1].length || a[0].localeCompare(b[0], 'zh-CN'));
const tagged = posts.filter((p) => p.data.tags.length > 0).length;
---

<Base title="标签" description="所有标签与对应的文章数量。">
  <div class="spread">
    <div class="sheet">
      <header class="sheet-head">
        <h1>标签</h1>
        <p class="mono">共 {tags.length} 个</p>
      </header>

      {
        tags.length === 0 ? (
          <p class="empty">还没有标签。</p>
        ) : (
          <>
            <p class="lede">按文章数从多到少排列。数字是带这个标签的文章篇数。</p>
            <ul class="cloud">
              {tags.map(([tag, list]) => (
                <li>
                  <a class="chip" href={tagUrl(tag)}>
                    {tag} <span class="n">{list.length}</span>
                  </a>
                </li>
              ))}
            </ul>
          </>
        )
      }
    </div>

    <aside class="margin" aria-label="标签统计">
      <h2 class="margin-h mono">统计</h2>
      <ul class="ledger">
        <li>
          <span>标签</span>
          <span class="mono">{tags.length} 个</span>
        </li>
        <li>
          <span>带标签的文章</span>
          <span class="mono">{tagged} / {posts.length} 篇</span>
        </li>
        {
          tags[0] && (
            <li>
              <span>用得最多</span>
              <a class="mono" href={tagUrl(tags[0][0])}>
                {tags[0][0]}
              </a>
            </li>
          )
        }
      </ul>
    </aside>
  </div>
</Base>

<style>
  .cloud {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin: 1.5rem 0 0;
    padding: 1.5rem 0 0;
    list-style: none;
    border-top: 1px solid var(--rule);
  }

  .cloud .chip {
    font-size: 0.875rem;
    padding: 0.3rem 1rem 0.3rem 0.65rem;
  }
</style>
