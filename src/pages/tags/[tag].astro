---
import TermList from '@/layouts/TermList.astro';
import { getPosts, groupBy, slugify, type Post } from '@/lib/posts';

export async function getStaticPaths() {
  const tags = groupBy(await getPosts(), (p) => p.data.tags);
  return [...tags].map(([tag, posts]) => ({ params: { tag: slugify(tag) }, props: { tag, posts } }));
}

const { tag, posts } = Astro.props as { tag: string; posts: Post[] };
---

<TermList kicker={`Tag · ${posts.length} entries`} title={`# ${tag}`} posts={posts} back={{ href: '/tags/', label: '全部标签' }} />
