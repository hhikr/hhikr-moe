---
import Base from '@/layouts/Base.astro';
import Comments from '@/components/Comments.astro';
import { FRIENDS } from '@/data/links';
import { AUTHOR, SITE } from '@/site.config';

const mine = [
  ['名称', SITE.title],
  ['链接', SITE.url],
  ['简介', AUTHOR.headline],
  ['头像', `${SITE.url}/apple-touch-icon.png`],
];
---

<Base title="友链" description="朋友们的网站。">
  <div class="wrap">
    <header class="page-head">
      <p class="label kicker">Links · {FRIENDS.length} friends</p>
      <h1>友链<span class="en">Links</span></h1>
      <p>交换友链请在下方留言。</p>
    </header>

    <ul class="friends">
      {
        FRIENDS.map((f, i) => (
          <li class="rise" style={`--i:${i}`}>
            <a href={f.url} target="_blank" rel="noopener">
              {f.avatar ? <img src={f.avatar} alt="" width="56" height="56" loading="lazy" /> : <span class="initial cjk">{f.name.slice(0, 1)}</span>}
              <span class="info">
                <span class="name cjk">{f.name}</span>
                {f.description && <span class="desc">{f.description}</span>}
                <span class="url label">{f.url.replace(/^https?:\/\//, '')}</span>
              </span>
            </a>
          </li>
        ))
      }
    </ul>

    <section class="mine">
      <header class="section-head">
        <span class="label">§</span>
        <h2>本站信息</h2>
        <span class="en">Swap links</span>
      </header>
      <dl>
        {
          mine.map(([k, v]) => (
            <div>
              <dt class="label">{k}</dt>
              <dd><code>{v}</code></dd>
            </div>
          ))
        }
      </dl>
    </section>
    <div class="measure"><Comments /></div>
  </div>
</Base>

<style>
  .friends {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(19rem, 1fr));
    gap: 1rem;
    list-style: none;
    margin: 0;
    padding: 2rem 0 0;
    border-top: 1.5px solid var(--rule-strong);
  }

  .friends a {
    display: flex;
    gap: 1rem;
    align-items: center;
    padding: 1.1rem;
    border: 1px solid var(--rule);
    border-radius: var(--radius);
    background: var(--card);
    transition: transform 0.3s var(--ease), border-color 0.3s, box-shadow 0.3s;
  }

  .friends a:hover {
    transform: translateY(-3px);
    border-color: var(--ink);
    box-shadow: 5px 5px 0 var(--sky-soft);
  }

  .friends img,
  .initial {
    flex: none;
    width: 56px;
    height: 56px;
    border-radius: 50%;
    object-fit: cover;
  }

  .initial {
    display: grid;
    place-items: center;
    background: var(--sky-soft);
    color: var(--sky-ink);
    font-size: 1.5rem;
  }

  .info {
    display: flex;
    flex-direction: column;
    min-width: 0;
  }

  .name {
    font-size: 1.2rem;
  }

  .desc {
    font-size: 0.88rem;
    color: var(--ink-2);
    line-height: 1.5;
  }

  .url {
    margin-top: 0.3rem;
    text-transform: none;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .mine {
    margin-top: 4rem;
  }

  .measure {
    max-width: var(--measure);
  }

  .mine dl {
    margin: 0;
    display: grid;
    gap: 0.6rem;
  }

  .mine div {
    display: grid;
    grid-template-columns: 4rem minmax(0, 1fr);
    align-items: baseline;
  }

  .mine dd {
    margin: 0;
    overflow-wrap: anywhere;
  }

  .mine code {
    font-family: var(--font-mono);
    font-size: 0.86rem;
    padding: 0.1em 0.4em;
    background: var(--code-bg);
    border: 1px solid var(--rule);
    border-radius: 3px;
  }
</style>
