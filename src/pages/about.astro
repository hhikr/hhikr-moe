---
import { Image } from 'astro:assets';
import Base from '@/layouts/Base.astro';
import Icon from '@/components/Icon.astro';
import { AUTHOR, SITE, SOCIALS } from '@/site.config';
import { CHANGELOG } from '@/data/changelog';
import avatar from '@/assets/avatar.png';

const stack = [
  ['Astro', '页面框架'],
  ['SQLite', '文章、评论与统计'],
  ['Pagefind', '全文搜索（含中文分词）'],
  ['KaTeX', '数学公式'],
  ['Shiki', '代码高亮'],
  ['霞鹜文楷', '阅读字体'],
  ['思源黑体', '界面字体（中文）'],
  ['JetBrains Mono', '界面字体（西文）与等宽字体'],
];
---

<Base title="关于" description={`关于 ${AUTHOR.name} 与这个网站。`}>
  <div class="spread">
    <div class="sheet">
      <header class="sheet-head">
        <h1>你好，我是 {AUTHOR.name}</h1>
        <p class="mono">since {SITE.since}</p>
      </header>

      <div class="text">
        <p class="lead">{AUTHOR.bio}。</p>
        <p>
          软件工程专业的学生。早就想做个人网站了，拖了很久终于做了出来。这里什么都可能放：专业、语言和音乐的学习笔记，观影杂谈，
          或者是捣鼓一些自己感兴趣的东西——尝试不同的 Linux 发行版和桌面环境、折腾网站的新功能之类。
        </p>
        <p>
          网站的来路记在<a href="/posts/time-machine/">「时间胶囊」</a>里，最初的建站过程见<a href="/posts/building-website/">「记录我的第一次建站」</a>。
        </p>
      </div>

      <section>
        <h2 class="group-head">
          <span>网站沿革</span>
          <span class="mono">{CHANGELOG.length} 次</span>
        </h2>
        <ol class="timeline">
          {
            CHANGELOG.map((c, i) => (
              <li>
                <span class:list={['tag', { 'is-current': i === 0 }]}>v{c.version}</span>
                <time class="mono" datetime={c.date}>
                  {c.date.replaceAll('-', '.')}
                </time>
                <span class="what">
                  <span class="name">{c.title}</span>
                  <span class="note">{c.note}</span>
                </span>
              </li>
            ))
          }
        </ol>
      </section>

      <section>
        <h2 class="group-head">
          <span>本站使用</span>
          <span class="mono">{stack.length} 项</span>
        </h2>
        <dl class="stack">
          {
            stack.map(([k, v]) => (
              <div>
                <dt>{k}</dt>
                <dd>{v}</dd>
              </div>
            ))
          }
        </dl>
      </section>
    </div>

    <aside class="margin" aria-label="站长">
      <figure class="portrait">
        <Image src={avatar} alt={`${AUTHOR.name} 的头像：闭着眼大笑的短发女孩，铅笔线稿`} width={480} />
        <figcaption>{AUTHOR.headline}</figcaption>
      </figure>
      <h2 class="margin-h mono">在别处</h2>
      <ul class="ledger socials">
        {
          SOCIALS.map((s) => (
            <li>
              <a href={s.href} target="_blank" rel="noopener noreferrer me">
                <Icon name={s.icon} size={16} />
                {s.label}
              </a>
            </li>
          ))
        }
      </ul>
    </aside>
  </div>
</Base>

<style>
  .text {
    margin-top: 1.75rem;
    font-size: var(--t-body);
    line-height: 1.85;
  }

  .text p {
    margin: 0 0 1.1rem;
    color: var(--ink-2);
  }

  .text .lead {
    font-size: var(--t-title);
    line-height: 1.35;
    color: var(--ink);
  }

  /* links read the way they do in an article: ink over a yellow block */
  .text a {
    color: var(--ink);
    text-decoration: underline;
    text-decoration-color: var(--signal);
    text-decoration-thickness: 0.4em;
    text-underline-offset: -0.18em;
    text-decoration-skip-ink: none;
  }

  :global(:root[data-theme='dark']) .text a {
    text-decoration-thickness: 1.5px;
    text-underline-offset: 0.25em;
  }

  .timeline {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .timeline li {
    display: grid;
    grid-template-columns: 7.5rem 6rem minmax(0, 1fr);
    gap: 0.25rem 1rem;
    align-items: baseline;
    padding: 0.9rem 0;
    border-bottom: 1px solid var(--rule);
  }

  .timeline .tag {
    justify-self: start;
  }

  .what {
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
  }

  .what .name {
    font-size: var(--t-body);
  }

  .note {
    color: var(--ink-2);
    line-height: 1.7;
  }

  .stack {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 13rem), 1fr));
    gap: 1px;
    margin: 0;
    background: var(--rule);
    border-bottom: 1px solid var(--rule);
  }

  .stack div {
    padding: 0.9rem 1rem 1rem;
    background: var(--panel);
  }

  .stack dt {
    font-family: var(--font-ui);
    font-weight: 700;
  }

  .stack dd {
    margin: 0.15rem 0 0;
    font-size: 0.875rem;
    color: var(--ink-2);
  }

  .portrait {
    max-width: 18rem;
    margin: 0 0 2.5rem;
  }

  .portrait img {
    display: block;
    width: 100%;
    height: auto;
    border: 1px solid var(--rule);
    background: #fffff3;
  }

  .portrait figcaption {
    margin-top: 0.6rem;
    font-family: var(--font-mono);
    font-size: var(--t-mono);
    color: var(--ink-2);
  }

  .socials a {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
  }

  @media (max-width: 720px) {
    .timeline li {
      grid-template-columns: auto minmax(0, 1fr);
    }
    .what {
      grid-column: 1 / -1;
    }
  }

  @media (max-width: 959px) {
    .portrait {
      max-width: 12rem;
    }
  }
</style>
