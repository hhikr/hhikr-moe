---
// Not linked from anywhere: readers are only asked to sign in when they post
// a comment. This page is the direct entrance, mainly for the endministrator.
import Base from '@/layouts/Base.astro';
import { landingFor, safeReturnPath } from '@/lib/http';
import { googleConfig } from '@/server/config.ts';

export const prerender = false;

const returnTo = safeReturnPath(Astro.url.searchParams.get('return'));
if (Astro.locals.user) return Astro.redirect(landingFor(Astro.locals.user, returnTo), 302);

const ERRORS: Record<string, string> = {
  expired: '登录过程超时了，请再试一次。',
  cancelled: '已取消 Google 登录。',
  google: 'Google 登录没有成功，请稍后再试。',
  banned: '这个账号已被停用。',
  link: '登录链接无效或已过期。',
};
const error = ERRORS[Astro.url.searchParams.get('error') ?? ''];
const google = !!googleConfig();
---

<Base title="登录" noindex>
  <div class="spread">
    <div class="sheet">
      <header class="sheet-head">
        <h1>登录</h1>
        <p class="mono">或注册新账号</p>
      </header>

      {error && <p class="notice top" role="alert">{error}</p>}

      <div class="door">
        {
          google && (
            <a class="btn go google" data-astro-prefetch="false" href={`/api/auth/google/start?return=${encodeURIComponent(returnTo)}`}>
              使用 Google 登录
            </a>
          )
        }

        <form class="form" data-account data-return={returnTo} novalidate>
          <label class="field">
            <span class="label">名字</span>
            <input name="name" autocomplete="username" required maxlength="40" />
            <small>注册时填昵称；登录时填完整的名字，例如 narrator#1145。</small>
          </label>
          <label class="field">
            <span class="label">密码</span>
            <input name="password" type="password" autocomplete="current-password" required minlength="10" maxlength="200" />
            <small>至少 10 个字符。没有绑定邮箱，忘记后无法找回。</small>
          </label>
          <!-- Hidden from people; bots that fill it in are turned away. -->
          <input class="trap" name="website" tabindex="-1" autocomplete="off" aria-hidden="true" />
          <p class="notice" data-message role="status"></p>
          <p class="actions">
            <button class="btn go" type="submit" data-action="login">登录</button>
            <button class="btn" type="button" data-action="register">注册新账号</button>
          </p>
        </form>

        <div class="welcome" data-welcome hidden>
          <p>注册好了。你的完整名字是</p>
          <p class="handle" data-handle></p>
          <p>昵称可以和别人重名，后面的四位数字用来区分。<strong>以后登录需要输入这个完整的名字</strong>，请记下来。</p>
          <a class="btn go" data-continue href={returnTo}>知道了</a>
        </div>
      </div>
    </div>

    <aside class="margin" aria-label="说明">
      <h2 class="margin-h mono">账号</h2>
      <ul class="ledger">
        <li><span>浏览</span><span class="mono">不需要登录</span></li>
        <li><span>发表评论</span><span class="mono">需要账号</span></li>
        <li><span>找回密码</span><span class="mono">联系站长</span></li>
      </ul>
      <p class="mono fine"><a href="/privacy/">隐私说明</a></p>
    </aside>
  </div>
</Base>

<script>
  import { api, solveChallenge } from '@/scripts/account';

  const form = document.querySelector<HTMLFormElement>('[data-account]');
  const message = document.querySelector<HTMLElement>('[data-message]')!;
  const welcome = document.querySelector<HTMLElement>('[data-welcome]')!;

  function say(text: string) {
    message.textContent = text;
  }

  async function submit(action: 'login' | 'register') {
    if (!form) return;
    const data = new FormData(form);
    const name = String(data.get('name') ?? '').trim();
    const password = String(data.get('password') ?? '');
    if (!name || !password) return say('请填写名字和密码。');
    const buttons = form.querySelectorAll<HTMLButtonElement>('button');
    buttons.forEach((b) => (b.disabled = true));
    try {
      if (action === 'login') {
        if (!name.includes('#')) return say('登录时请填写完整的名字，例如 narrator#1145。');
        const res = await api('/api/auth/login', { handle: name, password });
        if (!res.ok) return say(res.error.message);
        location.assign(form.dataset.return || '/');
        return;
      }
      say('正在验证…');
      const challenge = await solveChallenge();
      const res = await api('/api/auth/register', { nickname: name, password, website: data.get('website'), challenge });
      if (!res.ok) return say(res.error.message);
      say('');
      form.hidden = true;
      document.querySelector<HTMLElement>('.google')?.setAttribute('hidden', '');
      welcome.querySelector<HTMLElement>('[data-handle]')!.textContent = res.data.user.handle;
      welcome.hidden = false;
    } finally {
      buttons.forEach((b) => (b.disabled = false));
    }
  }

  form?.addEventListener('submit', (e) => {
    e.preventDefault();
    submit('login');
  });
  form?.querySelector('[data-action="register"]')?.addEventListener('click', () => submit('register'));
</script>

<style>
  .top {
    margin-top: 1.5rem;
  }

  .door {
    max-width: 26rem;
    margin-top: 2rem;
  }

  .google {
    width: 100%;
    justify-content: center;
    margin-bottom: 2rem;
  }

  form {
    display: grid;
    gap: 1.2rem;
  }

  .google + form {
    padding-top: 2rem;
    border-top: 1px solid var(--rule);
  }

  .trap {
    position: absolute;
    left: -100vw;
    width: 1px;
    height: 1px;
    opacity: 0;
  }

  form[hidden],
  .google[hidden] {
    display: none;
  }

  .welcome p {
    margin: 0 0 0.75rem;
    line-height: 1.75;
  }

  .welcome strong {
    text-decoration: underline;
    text-underline-offset: 0.3em;
  }

  .handle {
    display: inline-block;
    padding: 0.1em 0.45em;
    background: var(--signal);
    color: var(--on-signal);
    font-family: var(--font-mono);
    font-size: 1.6rem;
  }

  .fine {
    margin: 1.5rem 0 0;
  }

  .fine a {
    border-bottom: 1px solid var(--rule);
  }

  .fine a:hover {
    color: var(--ink);
    border-color: var(--ink);
  }
</style>
