---
import Base from '@/layouts/Base.astro';
import PostRecord from '@/components/PostRecord.astro';
import Heatmap from '@/components/Heatmap.astro';
import { CATEGORIES } from '@/site.config';
import { categoryUrl, getPosts, groupBy, postNumbers, viewerOf, yearOf } from '@/lib/posts';

export const prerender = false;

const posts = getPosts(viewerOf(Astro.locals));
const numbers = postNumbers();
const years = [...groupBy(posts, (p) => yearOf(p.data.date))];
const counts = groupBy(posts, (p) => p.data.category);
const words = posts.reduce((n, p) => n + p.words, 0);
---

<Base title="文章" description="全部文章归档，按年份排列。">
  <div class="spread">
    <div class="sheet">
      <header class="sheet-head">
        <h1>文章</h1>
        <p class="mono">共 {posts.length} 篇</p>
      </header>

      {
        posts.length === 0 ? (
          <p class="empty">还没有发布文章。</p>
        ) : (
          <>
            <div class="filters" role="toolbar" aria-label="按分类筛选" data-filters>
              <button type="button" class="chip" aria-pressed="true" data-filter="all">
                全部 <span class="n">{posts.length}</span>
              </button>
              {Object.entries(CATEGORIES).map(([key, c]) => (
                <button type="button" class="chip" aria-pressed="false" data-filter={key}>
                  {c.name} <span class="n">{counts.get(key)?.length ?? 0}</span>
                </button>
              ))}
            </div>

            {years.map(([year, list]) => (
              <section data-year>
                <h2 class="group-head">
                  <span class="mono year">{year}</span>
                  <span class="mono" data-year-count>
                    {list.length} 篇
                  </span>
                </h2>
                <ol class="records">
                  {list.map((p) => (
                    <PostRecord post={p} number={numbers.get(p.id)} data-item="" data-cat={p.data.category ?? ''} />
                  ))}
                </ol>
              </section>
            ))}
          </>
        )
      }
    </div>

    <aside class="margin" aria-label="文章统计">
      {
        posts.length > 0 && (
          <>
            <h2 class="margin-h mono">写作日历</h2>
            <Heatmap posts={posts} />
          </>
        )
      }
      <h2 class="margin-h mono">按分类</h2>
      <ul class="ledger">
        {
          Object.entries(CATEGORIES).map(([key, c]) => (
            <li>
              <a href={categoryUrl(c.slug)}>{c.name}</a>
              <span class="mono">{counts.get(key)?.length ?? 0} 篇</span>
            </li>
          ))
        }
        <li>
          <span>字数合计</span>
          <span class="mono">{words.toLocaleString('zh-CN')} 字</span>
        </li>
      </ul>
    </aside>
  </div>
</Base>

<script>
  const bar = document.querySelector('[data-filters]');
  const items = [...document.querySelectorAll<HTMLElement>('[data-item]')];
  const years = [...document.querySelectorAll<HTMLElement>('[data-year]')];
  let cat = new URLSearchParams(location.search).get('c') ?? 'all';

  function apply() {
    bar?.querySelectorAll<HTMLElement>('[data-filter]').forEach((b) => b.setAttribute('aria-pressed', String(b.dataset.filter === cat)));
    for (const it of items) {
      it.hidden = cat !== 'all' && it.dataset.cat !== cat;
    }
    for (const y of years) {
      const shown = y.querySelectorAll('[data-item]:not([hidden])').length;
      y.hidden = shown === 0;
      const count = y.querySelector('[data-year-count]');
      if (count) count.textContent = `${shown} 篇`;
    }
  }

  bar?.addEventListener('click', (e) => {
    const b = (e.target as HTMLElement).closest<HTMLElement>('[data-filter]');
    if (!b) return;
    cat = b.dataset.filter!;
    const url = new URL(location.href);
    cat === 'all' ? url.searchParams.delete('c') : url.searchParams.set('c', cat);
    history.replaceState(null, '', url);
    apply();
  });
  apply();
</script>

<style>
  .year {
    font-size: 1.25rem;
    font-weight: 700;
    color: var(--ink);
  }

  .records > li[hidden] {
    display: none;
  }
</style>
