---
// Shell of the management area: a command bar with the sections across the
// top, and the work surface under it. The site's own navigation is left out. The middleware has already made sure the visitor is the
// endministrator before any page using this layout renders.
import Base from './Base.astro';
import Icon from '@/components/Icon.astro';
import { backupStatus } from '@/server/backup.ts';
import { commentCounts } from '@/server/comments.ts';
import { cosmoOrigin } from '@/server/cosmo.ts';

interface Props {
  title: string;
  en: string;
  /** Short line under the title saying what this screen is for. */
  lead?: string;
  /** The page draws its own title: leave the heading out. */
  plain?: boolean;
  /** Use the whole width of the window, for the editor. */
  wide?: boolean;
}
const { title, en, lead, plain, wide } = Astro.props;
const user = Astro.locals.user!;
const path = Astro.url.pathname;
const pending = commentCounts().hidden;
const backupProblems = backupStatus().warnings.filter((w) => w.level === 'red').length;

const sections = [
  { href: '/endmin/', label: '概览', en: 'Overview' },
  { href: '/endmin/posts/', label: '文章', en: 'Posts' },
  { href: '/endmin/works/', label: '作品', en: 'Works' },
  { href: '/endmin/media/', label: '媒体', en: 'Media' },
  { href: '/endmin/comments/', label: '评论', en: 'Comments', badge: pending },
  { href: '/endmin/users/', label: '用户', en: 'Users' },
  { href: '/endmin/stats/', label: '统计', en: 'Stats' },
  { href: '/endmin/backup/', label: '备份', en: 'Backup', badge: backupProblems },
];
// Hermes has its own two front ends on the Cosmo subdomain; both take the same sign-in.
const cosmo = cosmoOrigin();
const hermes = cosmo
  ? [
      { href: `${cosmo}/`, label: '对话', en: 'Cosmo' },
      { href: `${cosmo}/admin/`, label: '管理页', en: 'Dashboard' },
    ]
  : [];
const isCurrent = (href: string) => (href === '/endmin/' ? path === href : path.startsWith(href));
---

<Base title={`${title} · 管理`} noindex bare>
  <div class="em">
    <header class="em-bar">
      <a class="em-brand" href="/endmin/" aria-label="管理概览">
        <span class="em-seal" aria-hidden="true">E</span>
        <span class="em-word">
          ENDMIN
          <small>{user.nickname}</small>
        </span>
      </a>

      <nav class="em-nav" aria-label="管理">
        {
          sections.map((s) => (
            <a href={s.href} aria-current={isCurrent(s.href) ? 'page' : undefined}>
              <span class="zh">{s.label}</span>
              <span class="en">{s.en}</span>
              {!!s.badge && <span class="em-count">{s.badge}</span>}
            </a>
          ))
        }
      </nav>

      <div class="em-util">
        {hermes.map((s) => <a href={s.href} target="_blank" rel="noopener">Hermes {s.label}</a>)}
        <a href="/">查看网站</a>
        <button type="button" data-view-as>游客视角</button>
        <button type="button" data-logout>退出</button>
        <button type="button" class="em-theme" data-theme-toggle aria-label="切换主题"><Icon name="auto" size={16} /></button>
      </div>
    </header>

    <section class:list={['em-main', { wide }]}>
      {
        !plain && (
          <header class="em-head">
            <h1>{title}<span class="en">{en}</span></h1>
            {lead && <p>{lead}</p>}
          </header>
        )
      }
      <p class="em-flash" data-flash role="status" hidden></p>
      <slot />
    </section>
  </div>
</Base>

<script>
  import { api } from '@/scripts/account';

  const flash = document.querySelector<HTMLElement>('[data-flash]');

  // Browse the site exactly as someone who is not signed in would see it.
  document.querySelector('[data-view-as]')?.addEventListener('click', async () => {
    await api('/api/endmin/view-as', { guest: true });
    location.assign('/');
  });

  document.querySelector('[data-logout]')?.addEventListener('click', async () => {
    await api('/api/auth/logout', {});
    location.assign('/');
  });

  // Any button carrying data-api performs that request and reloads the page:
  //   <button data-api="/api/endmin/…" data-method="PATCH" data-body='{"…"}' data-confirm="…">
  document.addEventListener('click', async (e) => {
    const button = (e.target as HTMLElement).closest<HTMLButtonElement>('button[data-api]');
    if (!button) return;
    if (button.dataset.confirm && !confirm(button.dataset.confirm)) return;
    button.disabled = true;
    const method = (button.dataset.method ?? 'PATCH') as 'PATCH' | 'DELETE' | 'POST';
    const res = await api(button.dataset.api!, method === 'DELETE' ? undefined : JSON.parse(button.dataset.body ?? '{}'), method);
    if (res.ok) return location.reload();
    button.disabled = false;
    if (flash) {
      flash.textContent = res.error.message;
      flash.hidden = false;
    }
  });

  // Filter chips: <button data-filter="…"> shows rows whose data-group matches.
  const filters = document.querySelector('[data-filters]');
  filters?.addEventListener('click', (e) => {
    const chip = (e.target as HTMLElement).closest<HTMLElement>('[data-filter]');
    if (!chip) return;
    filters.querySelectorAll('[data-filter]').forEach((c) => c.setAttribute('aria-pressed', String(c === chip)));
    document.querySelectorAll<HTMLElement>('[data-group]').forEach((row) => {
      row.hidden = chip.dataset.filter !== 'all' && row.dataset.group !== chip.dataset.filter;
    });
  });
</script>

<style is:global>
  .em {
    width: 100%;
    font-family: var(--font-ui);
  }

  /* ---------- the command bar: the only navigation here ---------- */
  /* Dark in both themes, so the yellow block of "where you are" reads the same. */
  .em-bar {
    position: sticky;
    top: 0;
    z-index: 50;
    display: flex;
    flex-wrap: wrap;
    align-items: stretch;
    gap: 0 1.5rem;
    padding-inline: var(--pad);
    background: #161616;
    color: #ededed;
  }

  .em-brand {
    display: flex;
    align-items: center;
    gap: 0.7rem;
    padding-block: 0.6rem;
  }

  .em-seal {
    display: grid;
    place-items: center;
    width: 2.25rem;
    height: 2.25rem;
    background: linear-gradient(-45deg, transparent 0.45rem, var(--signal) calc(0.45rem + 0.5px));
    color: var(--on-signal);
    font-size: 1.3rem;
    font-weight: 800;
    line-height: 1;
  }

  .em-word {
    display: flex;
    flex-direction: column;
    font-size: 0.95rem;
    font-weight: 800;
    letter-spacing: 0.08em;
    line-height: 1.2;
  }

  .em-word small {
    font-size: 0.68rem;
    font-weight: 400;
    letter-spacing: 0;
    color: #a3a3a3;
  }

  .em-nav {
    display: flex;
    flex-wrap: wrap;
    align-items: stretch;
    margin-right: auto;
  }

  .em-nav a {
    position: relative;
    display: flex;
    flex-direction: column;
    justify-content: center;
    min-height: 3.4rem;
    padding: 0.3rem 1.15rem 0.3rem 0.8rem;
    color: #b8b8b8;
    transition:
      color 0.15s,
      background-color 0.15s;
  }

  .em-nav a .zh {
    font-size: 0.95rem;
    font-weight: 600;
    line-height: 1.3;
  }

  .em-nav a .en {
    font-size: 0.66rem;
    line-height: 1.3;
    opacity: 0.75;
  }

  /* Pointing at a section: a yellow line is driven along its foot. */
  .em-nav a::after {
    content: '';
    position: absolute;
    inset: auto 0 0 0;
    height: 3px;
    background: var(--signal);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 0.22s var(--mech);
  }

  .em-nav a:hover,
  .em-nav a:focus-visible {
    color: #fff;
    background: #232323;
  }

  .em-nav a:not([aria-current='page']):hover::after,
  .em-nav a:not([aria-current='page']):focus-visible::after {
    transform: none;
  }

  .em-nav a[aria-current='page'] {
    color: var(--on-signal);
    background: linear-gradient(-45deg, transparent calc(var(--cut) + 2px), var(--signal) calc(var(--cut) + 2.5px));
    view-transition-name: em-current;
  }

  /* Something is waiting: comments to review, a backup that failed. */
  .em-count {
    position: absolute;
    top: 0.35rem;
    right: 0.3rem;
    min-width: 1.4em;
    padding: 0 0.3em;
    background: var(--signal);
    color: var(--on-signal);
    outline: 2px solid #161616;
    font-size: 0.66rem;
    font-weight: 700;
    line-height: 1.5;
    text-align: center;
  }

  .em-util {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0 1.1rem;
    font-size: 0.78rem;
  }

  .em-util a,
  .em-util button {
    display: inline-flex;
    align-items: center;
    padding: 0.5rem 0;
    border: 0;
    background: none;
    color: #b8b8b8;
    font: inherit;
  }

  .em-util a:hover,
  .em-util button:hover {
    color: var(--signal);
  }

  /* ---------- work surface ---------- */
  .em-main {
    max-width: 88rem;
    margin-inline: auto;
    padding: clamp(1.25rem, 3vw, 2.25rem) var(--pad) 5rem;
  }

  .em-main.wide {
    max-width: 112rem;
  }

  /* A page's name, heavy, with a hatched bar running off beside it. */
  .em-head {
    display: grid;
    grid-template-columns: auto minmax(2rem, 1fr);
    align-items: center;
    gap: 0.4rem 1.25rem;
    margin-bottom: 1.5rem;
  }

  .em-head::after {
    content: '';
    grid-column: 2;
    grid-row: 1;
    height: 0.9rem;
    background: var(--hatch);
    border-left: 0.9rem solid var(--ink);
  }

  .em-head h1 {
    display: flex;
    align-items: baseline;
    gap: 0.75rem;
    margin: 0;
    font-size: clamp(1.9rem, 4vw, 2.6rem);
    font-weight: 800;
    line-height: 1.15;
    letter-spacing: -0.01em;
  }

  .em-head h1 .en {
    font-size: var(--t-mono);
    font-weight: 400;
    letter-spacing: 0;
    color: var(--ink-2);
  }

  .em-head p {
    grid-column: 1 / -1;
    margin: 0;
    color: var(--ink-2);
  }

  .em-mid {
    display: flex;
    align-items: center;
    gap: 1.25rem;
    font-weight: 800;
  }

  .em-mid::after {
    content: '';
    flex: 1;
    height: 0.7rem;
    background: var(--hatch);
    border-left: 0.7rem solid var(--ink);
  }

  /* Something went wrong: flagged in yellow, like everything that needs a look. */
  .em-flash {
    display: flex;
    align-items: baseline;
    gap: 0.6rem;
    margin: 0 0 1rem;
    padding: 0.6rem 0.9rem;
    border: 1px solid var(--ink);
    background: var(--panel);
    color: var(--ink);
  }

  .em-flash::before {
    content: '出错';
    flex: none;
    padding: 0 0.4em;
    background: var(--signal);
    color: var(--on-signal);
    font-size: 0.75rem;
    font-weight: 700;
  }

  .em-flash[hidden] {
    display: none;
  }

  /* A row of big figures on one plate. */
  .em-tiles {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(9rem, 1fr));
    margin-bottom: 1.25rem;
    padding: 0 1.15rem;
    background: var(--panel);
  }

  .em-tile {
    display: grid;
    gap: 0.15rem;
    padding: 1.2rem 1rem 1.2rem 0;
  }

  .em-tile + .em-tile {
    padding-left: 1.25rem;
    border-left: 1px solid var(--rule);
  }

  .em-tile .n {
    font-size: 2.4rem;
    font-weight: 800;
    line-height: 1.05;
    letter-spacing: -0.03em;
    font-variant-numeric: tabular-nums;
  }

  .em-tile .cjk {
    font-size: 0.85rem;
    color: var(--ink-2);
  }

  .em-cols {
    display: grid;
    grid-template-columns: minmax(0, 3fr) minmax(0, 2fr);
    align-items: start;
    gap: 1.25rem;
    margin-top: 1.25rem;
  }

  .em-cols > .em-panel + .em-panel {
    margin-top: 0;
  }

  /* A plate on the paper, with a heavy ink tab on its top edge that runs out
     along the whole edge when the plate is pointed at. The same as the
     overview's panels. */
  .em-panel {
    position: relative;
    min-width: 0;
    padding: 1rem 1.15rem 1.15rem;
    background: var(--panel);
    border: 1px solid var(--rule);
  }

  .em-panel::before {
    content: '';
    position: absolute;
    top: -1px;
    left: -1px;
    right: -1px;
    height: 5px;
    background: var(--ink);
    transform: scaleX(0.14);
    transform-origin: left;
    transition: transform 0.4s var(--mech);
    pointer-events: none;
  }

  .em-panel:hover::before,
  .em-panel:focus-within::before {
    transform: none;
  }

  @media (prefers-reduced-motion: reduce) {
    .em-panel::before {
      transition: none;
    }
  }

  .em-panel + .em-panel {
    margin-top: 1.25rem;
  }

  .em-panel > h2,
  .em-panel > header > h2 {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.4rem 0.75rem;
    margin: 0 0 0.6rem;
    font-size: 1rem;
    font-weight: 800;
  }

  .em-panel h2 > a,
  .em-panel h2 > .aside {
    margin-left: auto;
    color: var(--ink-2);
    font-size: 0.75rem;
    font-weight: 400;
    white-space: nowrap;
  }

  .em-panel h2 > a:hover {
    color: var(--ink);
    text-decoration: underline;
  }

  .em-panel h2 > .em-btn {
    margin-left: auto;
    font-weight: 400;
  }

  .em-panel h2 > .em-btn + .em-btn {
    margin-left: 0;
  }

  /* A list that fills a plate runs to its edges. */
  .em-panel > .em-rows {
    margin-inline: -1.15rem;
  }

  .em-panel > .em-rows > li {
    padding-inline: 1.15rem;
  }

  .em-panel > .em-rows:last-child > li:last-child {
    border-bottom: 0;
  }

  .em-panel > .em-rows:first-child {
    margin-top: -1rem;
    border-top: 0;
  }

  .em-panel > .em-rows:last-child {
    margin-bottom: -1.15rem;
  }

  .em-note {
    margin: 0.75rem 0 0;
    color: var(--ink-2);
    font-size: 0.85rem;
    line-height: 1.7;
  }

  .em-empty {
    margin: 0;
    padding: 1rem 0;
    border-top: 1px solid var(--rule);
    color: var(--ink-2);
  }

  .em-panel > .em-empty:first-child {
    border-top: 0;
    padding-top: 0.5rem;
  }

  .em-rows {
    list-style: none;
    margin: 0;
    padding: 0;
    border-top: 1px solid var(--rule);
  }

  .em-rows > li {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: 0.25rem 1rem;
    align-items: center;
    padding: 0.8rem 0;
    border-bottom: 1px solid var(--rule);
  }

  .em-rows > li[hidden] {
    display: none;
  }

  /* Pointing at a row: a bar comes down its left edge, as in the site's lists. */
  .em-rows > li {
    position: relative;
    transition: background-color 0.15s;
  }

  .em-rows > li::before {
    content: '';
    position: absolute;
    inset: 0 auto 0 0;
    width: 4px;
    background: var(--trace);
    transform: scaleY(0);
    transform-origin: top;
    transition: transform 0.2s var(--snap);
  }

  .em-rows > li:hover {
    background: var(--paper);
  }

  .em-rows > li:hover::before,
  .em-rows > li:focus-within::before {
    transform: none;
  }

  @media (prefers-reduced-motion: reduce) {
    .em-rows > li::before {
      transition: none;
    }
  }

  .em-rows .t {
    font-size: var(--t-body);
  }

  .em-rows .t a:hover {
    background: var(--signal);
    color: var(--on-signal);
  }

  .em-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.2rem 0.9rem;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--ink-2);
  }

  .em-meta a:hover {
    color: var(--ink);
  }

  .em-acts {
    display: flex;
    flex-wrap: wrap;
    justify-content: flex-end;
    gap: 0.35rem;
  }

  /* A button is a cut block, like every other thing that can be pressed. */
  .em-btn {
    --fill: var(--chip);
    --wipe: var(--signal);
    position: relative;
    isolation: isolate;
    display: inline-block;
    padding: 0.2em 1em 0.2em 0.75em;
    border: 0;
    background: var(--fill);
    -webkit-mask: linear-gradient(-45deg, transparent calc(var(--cut) - 0.5px), #000 var(--cut));
    mask: linear-gradient(-45deg, transparent calc(var(--cut) - 0.5px), #000 var(--cut));
    color: var(--ink);
    font-family: var(--font-mono);
    font-size: 0.75rem;
    line-height: 1.7;
    white-space: nowrap;
    transition:
      color 0.1s 0.05s,
      transform 0.1s;
  }

  /* The cut corner is a mask, so the focus ring is drawn inside the block. */
  .em-btn:focus-visible {
    outline-offset: -3px;
  }

  /* Pointing at a button drives its colour across it from the left. */
  .em-btn::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    background: var(--wipe);
    transform: translateX(-101%);
    transition: transform 0.24s var(--mech);
  }

  .em-btn:hover,
  .em-btn:focus-visible {
    color: var(--on-signal);
  }

  .em-btn:hover::before,
  .em-btn:focus-visible::before {
    transform: none;
  }

  .em-btn:active {
    transform: translateY(1px) scale(0.98);
  }

  .em-btn.go {
    --fill: var(--ink);
    color: var(--panel);
  }

  .em-btn.go:hover,
  .em-btn.go:focus-visible {
    color: var(--on-signal);
  }

  .em-btn.danger {
    --wipe: var(--danger);
  }

  .em-btn.danger:hover,
  .em-btn.danger:focus-visible {
    color: var(--panel);
  }

  @media (prefers-reduced-motion: reduce) {
    .em-btn::before {
      transition: none;
    }
  }
  .em-btn:disabled {
    opacity: 0.5;
    cursor: progress;
  }

  /* What state a thing is in. Live is solid ink, waiting in the wings is
     dashed, and what needs a look is a yellow block. No red: red is for
     deleting. */
  .em-state {
    display: inline-block;
    margin-left: 0.6em;
    padding: 0 0.5em;
    border: 1px solid currentColor;
    font-family: var(--font-mono);
    font-size: 0.7rem;
    line-height: 1.6;
    vertical-align: 0.15em;
    white-space: nowrap;
  }

  .em-state.published {
    color: var(--ink);
  }

  .em-state.hidden {
    color: var(--ink);
    border-style: dashed;
  }

  .em-state.draft {
    color: var(--ink-2);
    border-style: dashed;
  }

  .em-state.banned,
  .em-state.alert {
    border-color: var(--signal);
    background: var(--signal);
    color: var(--on-signal);
    font-weight: 700;
  }

  .em-filters {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.4rem;
    padding: 1.25rem 0;
  }

  .em-filters .chip {
    padding: 0.2em 1em 0.2em 0.75em;
  }

  /* The thing to do on this screen sits at the right end of the filters. */
  .em-filters > .end {
    margin-left: auto;
  }

  .em-filters + .em-panel {
    margin-top: 0;
  }

  .em-facts {
    margin: 0;
    border-top: 1px solid var(--rule);
  }

  .em-facts div {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    padding: 0.5rem 0;
    border-bottom: 1px solid var(--rule);
  }

  .em-facts dt {
    color: var(--ink-2);
  }

  .em-facts dd {
    margin: 0;
    font-family: var(--font-mono);
    font-size: var(--t-mono);
    font-variant-numeric: tabular-nums;
    text-align: right;
  }

  /* Needs a look: marked the way this site marks things, in yellow. */
  .em-facts .warn {
    padding: 0 0.4em;
    background: var(--signal);
    color: var(--on-signal);
    font-weight: 700;
  }

  .em-quote {
    grid-column: 1 / -1;
    margin: 0.2rem 0 0;
    padding-left: 0.8rem;
    border-left: 2px solid var(--rule);
    color: var(--ink-2);
    line-height: 1.65;
    overflow-wrap: anywhere;
  }

  .em-quote img {
    max-width: 10rem;
    max-height: 7rem;
  }

  .em-quote pre {
    margin: 0.3rem 0;
    padding: 0.5rem 0.7rem;
    background: var(--paper);
    font-size: 0.8rem;
    overflow-x: auto;
  }

  .em-quote.clip {
    display: -webkit-box;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 2;
    line-clamp: 2;
    overflow: hidden;
  }

  .em-user {
    display: flex;
    align-items: center;
    gap: 0.7rem;
  }

  .em-user img,
  .em-user .ph {
    flex: none;
    width: 2rem;
    height: 2rem;
    object-fit: cover;
    background: var(--chip);
  }

  .em-user .tag {
    font-family: var(--font-mono);
    font-size: 0.8em;
    color: var(--ink-2);
    background: none;
    padding: 0;
  }

  .em-switch {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    margin-left: auto;
    color: var(--ink-2);
  }

  @media (max-width: 860px) {
    /* The bar wraps to several lines here: let it scroll away with the page. */
    .em-bar {
      position: static;
