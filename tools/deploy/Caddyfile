hhikr.moe {
    root * /srv/hhikr/current
    encode zstd gzip

    @hashed path /_astro/*
    header @hashed Cache-Control "public, max-age=31536000, immutable"
    @html path / /hot100/* /posts/* /tags/* /categories/* /series/* /about/* /links/*
    header @html Cache-Control "no-cache"

    file_server
    handle_errors {
        rewrite * /404.html
        file_server
    }
}

www.hhikr.moe {
    redir https://hhikr.moe{uri} permanent
}
